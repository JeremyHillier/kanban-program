<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.104.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <AppChannel Condition="'$(AppChannel)'==''">Test</AppChannel>
    <DefineConstants Condition="'$(AppChannel)'=='Test'">$(DefineConstants);TEST_CHANNEL</DefineConstants>
    <Product Condition="'$(AppChannel)'=='Test'">Kanban Task Board (Test)</Product>
    <Product Condition="'$(AppChannel)'=='Production'">Kanban Task Board</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives inside this folder, so keep the SDK's default globs from pulling its
         files into the app itself. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- American-spelling word list added as a spell-check custom dictionary alongside the en-CA
         base language on task Details/Notes, so both Canadian and American spellings pass. -->
    <Resource Include="Assets\AmericanSpellingVariants.lex" />
    <!-- Ships inside the exe so the What's New screen can read it at runtime: the installer
         packages only the published binary, so a loose CHANGELOG.md wouldn't be there. Keeping it
         as the single source avoids maintaining a second copy of the release notes in code. -->
    <Resource Include="CHANGELOG.md" />
    <!-- The PDF report's stand-in font for a PC where Segoe UI can't be read (see PdfFontResolver).
         Lato is free to ship under the SIL Open Font License; the licence travels with it. -->
    <EmbeddedResource Include="Assets\Fonts\Lato-*.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Lato-OFL.txt" />
    <!-- The licence agreement and privacy note shown from the About screen (LegalDocuments). The
         installer shows the same EULA.txt on its licence page. -->
    <EmbeddedResource Include="Legal\EULA.txt" />
    <EmbeddedResource Include="Legal\PRIVACY.txt" />
  </ItemGroup>

</Project>
