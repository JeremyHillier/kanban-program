<Window x:Class="KanbanApp.Views.ImportedTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:KanbanApp.ViewModels"
        mc:Ignorable="d"
        Title="Imported Tasks" Height="620" Width="1400" MinWidth="1180" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <!-- Top-aligned so a row made taller by a wrapped task description doesn't stretch its
             dropdowns and date picker to match. -->
        <Style x:Key="CellMargin" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Imported Tasks" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Text="Uncheck Imported and Save to remove a task from this review list."
                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <!-- Header row. Its columns must match the row template's below exactly. They used to share
             sizes through SharedSizeGroup, but WPF treats shared columns as Auto, so Task Details
             grew to fit the longest description and pushed the Imported checkboxes off-screen.
             Instead the small columns are fixed and Task Details takes whatever width is left
             and wraps. The right margin is widened in code to match the rows' scrollbar. -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" Margin="1,10,1,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Task Details" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="Project" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="Goal" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="5" Text="Due Date" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="6" Text="Who" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="7" Text="Imported" Style="{StaticResource ColHeaderStyle}"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="RowsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="RowsScrollViewer_ScrollChanged">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImportedRowEditViewModel}">
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource CellMargin}" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" MaxLength="255"
                                             Padding="4,2" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="1" Style="{StaticResource CellMargin}" Padding="4,2"
                                              ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectedValue="{Binding ColumnId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="2" Style="{StaticResource CellMargin}" Padding="4,2"
                                              ItemsSource="{x:Static vm:PriorityOptions.All}" SelectedItem="{Binding Priority, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="3" Style="{StaticResource CellMargin}" Padding="4,2"
                                              ItemsSource="{Binding AvailableProjects}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding ProjectId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="4" Style="{StaticResource CellMargin}" Padding="4,2"
                                              ItemsSource="{Binding AvailableGoals}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding GoalId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <DatePicker Grid.Column="5" Style="{StaticResource CellMargin}" Padding="4,2"
                                                SelectedDate="{Binding DueDate, Mode=TwoWay}" Loaded="DatePicker_Loaded"
                                                Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="6" Style="{StaticResource CellMargin}" Padding="4,2"
                                              ItemsSource="{Binding AvailablePeople}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding WhoId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <CheckBox Grid.Column="7" Style="{StaticResource CellMargin}" IsChecked="{Binding IsImported, Mode=TwoWay}"
                                              HorizontalAlignment="Center" Margin="4,5,4,1"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyStateText" Grid.Row="2" Text="No imported tasks to review."
                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="90" Padding="0,6" IsCancel="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Save Changes" Width="120" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="SaveChanges_Click"
                    Background="#FF66BB6A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
