<Window x:Class="KanbanApp.Views.DeleteListEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Delete" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Deleting a project or person that tasks use: where those tasks go. Leaving them without, as deleting
         always did, is the first choice, so moving them is always something picked. Enter is Cancel: a quick
         Enter never deletes. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="QuestionText" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="1" x:Name="UsageText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Label Grid.Row="2" Content="_Move its tasks to" Target="{Binding ElementName=MoveToComboBox}" Padding="0" Margin="0,14,0,4"
               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <ComboBox Grid.Row="3" x:Name="MoveToComboBox" DisplayMemberPath="Name" Padding="6,4"
                  ToolTip="Where the tasks go. The first choice leaves them without, as before."
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <TextBlock Grid.Row="4" x:Name="HintText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Button MinWidth="96" Padding="14,6" Content="Help" HorizontalAlignment="Left"
                    Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Help for this window. (F1)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="96" Padding="14,6" x:Name="DeleteButton" Content="Delete" Click="Delete_Click"
                        Background="#FFB14A42" Foreground="White" ToolTip="Delete it, and move its tasks as chosen above. This cannot be undone."/>
                <Button MinWidth="96" Padding="14,6" Content="Cancel" Margin="8,0,0,0" IsCancel="True" IsDefault="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Keep it, and its tasks as they are. (Esc)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
