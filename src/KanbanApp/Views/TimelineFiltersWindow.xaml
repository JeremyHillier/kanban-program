<Window x:Class="KanbanApp.Views.TimelineFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Timeline Filters" Width="940" Height="460" MinWidth="720" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Limits the Timeline to some people, priorities or flags. Tick nothing in a list to include everything. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Show only tasks in the ticked projects and goals, for the ticked people, with the ticked priorities and flags. A task needs to match each list that has something ticked; tick nothing in a list to include everything."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Goal" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Who" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="6" Text="Priority" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="8" Text="Flags" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProjectsPanel" Margin="8,6"/></ScrollViewer>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GoalsPanel" Margin="8,6"/></ScrollViewer>
            </Border>
            <Border Grid.Row="1" Grid.Column="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PeoplePanel" Margin="8,6"/></ScrollViewer>
            </Border>
            <Border Grid.Row="1" Grid.Column="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PrioritiesPanel" Margin="8,6"/></ScrollViewer>
            </Border>
            <Border Grid.Row="1" Grid.Column="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FlagsPanel" Margin="8,6"/></ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Help" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Help for this window. (F1)"/>
                <Button Content="Clear All" Padding="12,6" Margin="8,0,0,0" Click="ClearAll_Click" ToolTip="Untick everything, so the Timeline shows all tasks"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Show" Width="90" Padding="0,6" IsDefault="True" Click="Show_Click" ToolTip="Apply the filter to the Timeline (Enter)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Cancel" Width="90" Padding="0,6" Margin="8,0,0,0" IsCancel="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close without changing the filter (Esc)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
