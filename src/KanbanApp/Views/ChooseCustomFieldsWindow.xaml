<Window x:Class="KanbanApp.Views.ChooseCustomFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        Title="Default Fields" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="12">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
        <StackPanel x:Name="FieldsPanel"/>
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button MinWidth="96" Padding="14,6" Grid.Column="0" Content="Help" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Help for this window. (F1)"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="96" Padding="14,6" Content="Save and Close" IsDefault="True" Click="Save_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Keep these choices"/>
                <Button MinWidth="96" Padding="14,6" Content="Cancel" IsCancel="True" Margin="8,0,0,0"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close without saving. (Esc)"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
