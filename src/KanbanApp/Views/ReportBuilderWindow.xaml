<Window x:Class="KanbanApp.Views.ReportBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Report Builder" Height="600" Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <!-- Same TwoWay-IsSelected pattern as the board's own filter lists: each ListBoxItem binds to
             its FilterOptionViewModel.IsSelected, so Ctrl/Shift-click multi-select needs no extra code. -->
        <Style x:Key="MultiSelectFilterListBoxStyle" TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="SavedViewsComboBox" Padding="6" Margin="0,0,8,0"
                      DisplayMemberPath="Name"
                      ToolTip="Saved report views - Load applies every field below, Save View captures them"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Grid.Column="1" Content="Load" Width="70" Padding="0,6" Margin="0,0,8,0" Click="LoadReportView_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Grid.Column="2" Content="Save View..." Width="90" Padding="0,6" Margin="0,0,8,0" Click="SaveReportView_Click"
                    Background="#FF66BB6A" Foreground="White"/>
            <Button Grid.Column="3" Content="Delete View" Width="90" Padding="0,6" Click="DeleteReportView_Click"
                    Background="#FFE57373" Foreground="White"/>
        </Grid>
        <!-- A list of tasks, or figures about them. The filters below apply to both; each has its own
             options, and the ones that don't apply are hidden (see ShowOptionsForReportType). -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Report type" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <RadioButton x:Name="TaskListRadio" Content="Task list" GroupName="ReportType" IsChecked="True" Margin="0,0,20,0"
                         Checked="ReportType_Checked" Foreground="{DynamicResource PrimaryTextBrush}"
                         ToolTip="A list of the tasks the filters pick"/>
            <RadioButton x:Name="StatisticsRadio" Content="Statistics" GroupName="ReportType"
                         Checked="ReportType_Checked" Foreground="{DynamicResource PrimaryTextBrush}"
                         ToolTip="Figures about the tasks the filters pick, over a period: added, finished, on time, how long they take"/>
        </StackPanel>
        <!-- Docked under the form, outside its scroll, so Preview and PDF never leave the screen. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The statistics report's own options, in place of the task list's grouping, sort and
                 scope (hidden while Statistics is chosen, and these while it isn't). -->
            <StackPanel Grid.Row="0" x:Name="StatisticsOptionsPanel" Visibility="Collapsed">
                <TextBlock Text="Period" Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="StatsPeriodComboBox" Padding="6" Width="170" SelectionChanged="StatsPeriodComboBox_SelectionChanged"
                              ToolTip="The days the report covers. A saved view keeps the choice, so Last month is always last month."
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock Text="From" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <DatePicker x:Name="StatsFromDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                                ToolTip="Choose Custom dates to set your own period"
                                Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBlock Text="To" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <DatePicker x:Name="StatsToDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                                ToolTip="Choose Custom dates to set your own period"
                                Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Break down by" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StatsBreakdownComboBox" Padding="6" Width="170"
                                  ToolTip="One row each in the breakdown table. A shared task counts under each of its people."
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}">
                            <ComboBoxItem Content="Project" Tag="Project"/>
                            <ComboBoxItem Content="Person" Tag="Who"/>
                            <ComboBoxItem Content="Priority" Tag="Priority"/>
                            <ComboBoxItem Content="Goal" Tag="Goal"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Over time" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="StatsOverTimeComboBox" Padding="6" Width="170"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}">
                            <ComboBoxItem Content="Week by week" Tag="Week"/>
                            <ComboBoxItem Content="Month by month" Tag="Month"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Sections" Style="{StaticResource FieldLabelStyle}"/>
                <WrapPanel>
                    <CheckBox x:Name="StatsSummaryCheckBox" Content="Summary" Margin="0,0,18,4" Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="Added, finished, finished on time, typical days to finish, open now and overdue now"/>
                    <CheckBox x:Name="StatsBreakdownCheckBox" Content="Breakdown" Margin="0,0,18,4" Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="The same figures for each project, person, priority or goal"/>
                    <CheckBox x:Name="StatsOverTimeCheckBox" Content="Over time" Margin="0,0,18,4" Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="Tasks added and finished in each week or month"/>
                    <CheckBox x:Name="StatsColumnTimesCheckBox" Content="Time in each column" Margin="0,0,18,4" Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="How long finished tasks spent in each column on the way to Done"/>
                </WrapPanel>
            </StackPanel>

            <TextBlock Grid.Row="0" x:Name="GroupByLabel" Text="Group by" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox Grid.Row="1" x:Name="GroupByComboBox" Padding="6" HorizontalAlignment="Left" Width="200" SelectedIndex="0"
                      SelectionChanged="GroupByComboBox_SelectionChanged"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}">
                <ComboBoxItem Content="None" Tag="None"/>
                <ComboBoxItem Content="Status" Tag="Status"/>
                <ComboBoxItem Content="Project" Tag="Project"/>
                <ComboBoxItem Content="Priority" Tag="Priority"/>
                <ComboBoxItem Content="Who" Tag="Who"/>
                <ComboBoxItem Content="Goal" Tag="Goal"/>
            </ComboBox>

            <TextBlock Grid.Row="2" x:Name="SortOrderLabel" Text="Sort order" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Grid.Row="3" x:Name="SortLevelsPanel" Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="1st" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SortLevel1ComboBox" Padding="6" Width="140" SelectedIndex="0" SelectionChanged="SortLevelComboBox_SelectionChanged"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="None" Tag="None"/>
                        <ComboBoxItem Content="Category" Tag="Category"/>
                        <ComboBoxItem Content="Priority" Tag="Priority"/>
                        <ComboBoxItem Content="Who" Tag="Who"/>
                        <ComboBoxItem Content="Due Date" Tag="Due Date"/>
                        <ComboBoxItem Content="Completed Date" Tag="Completed Date"/>
                        <ComboBoxItem Content="Project" Tag="Project"/>
                        <ComboBoxItem Content="Goal" Tag="Goal"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                    <TextBlock Text="2nd" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SortLevel2ComboBox" Padding="6" Width="140" SelectedIndex="0" SelectionChanged="SortLevelComboBox_SelectionChanged"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="None" Tag="None"/>
                        <ComboBoxItem Content="Category" Tag="Category"/>
                        <ComboBoxItem Content="Priority" Tag="Priority"/>
                        <ComboBoxItem Content="Who" Tag="Who"/>
                        <ComboBoxItem Content="Due Date" Tag="Due Date"/>
                        <ComboBoxItem Content="Completed Date" Tag="Completed Date"/>
                        <ComboBoxItem Content="Project" Tag="Project"/>
                        <ComboBoxItem Content="Goal" Tag="Goal"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="3rd" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SortLevel3ComboBox" Padding="6" Width="140" SelectedIndex="0" SelectionChanged="SortLevelComboBox_SelectionChanged"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="None" Tag="None"/>
                        <ComboBoxItem Content="Category" Tag="Category"/>
                        <ComboBoxItem Content="Priority" Tag="Priority"/>
                        <ComboBoxItem Content="Who" Tag="Who"/>
                        <ComboBoxItem Content="Due Date" Tag="Due Date"/>
                        <ComboBoxItem Content="Completed Date" Tag="Completed Date"/>
                        <ComboBoxItem Content="Project" Tag="Project"/>
                        <ComboBoxItem Content="Goal" Tag="Goal"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="TaskScopeLabel" Text="Task scope" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Grid.Row="5" x:Name="TaskScopePanel" Orientation="Horizontal">
                <RadioButton x:Name="BoardOnlyRadio" Content="Board tasks" GroupName="ArchiveScope" IsChecked="True" Margin="0,0,20,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton x:Name="BoardAndArchivedRadio" Content="Board tasks + archived" GroupName="ArchiveScope" Margin="0,0,20,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton x:Name="ArchivedOnlyRadio" Content="Archived only (completed tasks)" GroupName="ArchiveScope"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Text="Page orientation (PDF)" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Grid.Row="7" Orientation="Horizontal">
                <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="PageOrientation" IsChecked="True" Margin="0,0,20,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="PageOrientation"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="8" x:Name="ArchivedRangeLabel" Text="Archived date range (applies to archived tasks only)" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Grid.Row="9" x:Name="ArchivedRangePanel" Orientation="Horizontal">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <DatePicker x:Name="ArchivedFromDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                <Button Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayArchivedFrom_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearArchivedFrom_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <DatePicker x:Name="ArchivedToDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                <Button Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayArchivedTo_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearArchivedTo_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <CheckBox Grid.Row="10" x:Name="IncludeNotesCheckBox" Content="Include notes" Margin="0,14,0,4"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>
            <CheckBox Grid.Row="11" x:Name="IncludeSubTasksCheckBox" Content="Include sub-tasks" Margin="0,0,0,4"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>
            <CheckBox Grid.Row="12" x:Name="IncludeSubTaskSummaryCheckBox"
                      Content="Include sub-task completion summary (e.g. how many times a sub task was completed)" Margin="0,0,0,4"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>

            <Grid Grid.Row="13" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="?" Width="32" Padding="0,6" Margin="0,0,8,0" Click="Help_Click" ToolTip="Help"
                            Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="Reset all fields" Width="120" Padding="0,6" Click="Reset_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Width="80" Padding="0,6" IsCancel="True"
                            Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="Preview" Width="90" Padding="0,6" Margin="8,0,0,0" Click="Preview_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="PDF" Width="90" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="Pdf_Click"
                            Background="#FF66BB6A" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Report title" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ReportTitleTextBox" Padding="6" Text="Kanban Task Report"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="IncludeColumnsLabel" Text="Include Columns" Style="{StaticResource FieldLabelStyle}"/>
        <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ColumnsPanel"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Filters" Style="{StaticResource SectionHeaderStyle}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Project (Ctrl/Shift-click for multiple)" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Row="5" Grid.Column="2" Text="Priority (Ctrl/Shift-click for multiple)" Style="{StaticResource FieldLabelStyle}"/>
        <ListBox Grid.Row="6" Grid.Column="0" x:Name="ProjectFilterListBox" Style="{StaticResource MultiSelectFilterListBoxStyle}"/>
        <ListBox Grid.Row="6" Grid.Column="2" x:Name="PriorityFilterListBox" Style="{StaticResource MultiSelectFilterListBoxStyle}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Who (Ctrl/Shift-click for multiple)" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Row="7" Grid.Column="2" Text="Goal" Style="{StaticResource FieldLabelStyle}"/>
        <ListBox Grid.Row="8" Grid.Column="0" x:Name="WhoFilterListBox" Style="{StaticResource MultiSelectFilterListBoxStyle}"/>
        <ComboBox Grid.Row="8" Grid.Column="2" x:Name="GoalFilterComboBox" Padding="6" VerticalAlignment="Top"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Flag" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Row="9" Grid.Column="2" x:Name="DueFilterLabel" Text="Due" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="10" Grid.Column="0" x:Name="FlagFilterComboBox" Padding="6"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <ComboBox Grid.Row="10" Grid.Column="2" x:Name="DueFilterComboBox" Padding="6"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DueRangeHeader" Text="Due date range (this report only)" Style="{StaticResource SectionHeaderStyle}"/>
        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DueRangePanel">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <DatePicker x:Name="DueFromDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                        Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayDueFrom_Click"
                    ToolTip="Today, whenever the report is run. Saved in a view, it stays 'today' rather than becoming a fixed date. Right-click for so many days from today."
                    PreviewMouseRightButtonUp="TodayDueFrom_RightClick"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueFrom_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="To" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <DatePicker x:Name="DueToDatePicker" Padding="4" Width="140" Loaded="DatePicker_Loaded"
                        Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayDueTo_Click"
                    ToolTip="Today, whenever the report is run. Saved in a view, it stays 'today' rather than becoming a fixed date. Right-click for so many days from today."
                    PreviewMouseRightButtonUp="TodayDueTo_RightClick"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueTo_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
        <!-- Says what a saved view will keep for each date: the word today (worked out afresh each
             time the report runs) or the fixed day picked from the calendar. -->
        <TextBlock x:Name="DateKindText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
        </StackPanel>
        <CheckBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" x:Name="IncludeNoDueDateCheckBox" Content="Include tasks with no due date"
                  Margin="0,6,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Text="Custom filters (select one or more to override the filters above)"
                   Style="{StaticResource SectionHeaderStyle}"/>
        <WrapPanel Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" x:Name="CustomFiltersPanel"/>

        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
