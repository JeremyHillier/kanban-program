<Window x:Class="KanbanApp.Views.TaskFileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        Title="Task File" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox x:Name="NameBox" Padding="6" MaxLength="80" Margin="0,0,0,10"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock Text="Description (optional)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox x:Name="DescriptionBox" Padding="6" MaxLength="300" Height="56" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>

        <!-- Only when making a template: which parts of the file go into it. -->
        <StackPanel x:Name="PartsPanel" Visibility="Collapsed" Margin="0,0,0,6">
            <TextBlock Text="Include" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="The columns, priorities, custom filters, saved reports and board settings are always included. Finished, archived and deleted tasks, task history and attachments never are."
                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <UniformGrid Columns="2">
                <CheckBox x:Name="ProjectsBox" Content="Projects and their milestones" IsChecked="True" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="GoalsBox" Content="Goals and their milestones" IsChecked="True" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="PeopleBox" Content="People" IsChecked="True" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="FlagsBox" Content="Flags" IsChecked="True" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="TasksBox" Content="Open tasks (recurring ones included)" IsChecked="False" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"
                          ToolTip="Every task not yet Done, with its sub-tasks, notes, people and flags. Attachments are not copied."/>
                <CheckBox x:Name="TaskTemplatesBox" Content="Task templates" IsChecked="True" Margin="0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </UniformGrid>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Button Content="Help" Width="60" Padding="0,6" HorizontalAlignment="Left" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Open Help at the section about task files. (F1)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" Width="90" Padding="0,6" IsDefault="True" Click="Ok_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Cancel" Width="80" Padding="0,6" Margin="8,0,0,0" IsCancel="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close without saving. (Esc)"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
