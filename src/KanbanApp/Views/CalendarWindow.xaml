<Window x:Class="KanbanApp.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        Title="Calendar" Height="740" Width="1200" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Calendar" FontWeight="Bold" FontSize="20" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#x25C0;" Padding="10,6" Click="Prev_Click" ToolTip="Earlier (Left arrow)" AutomationProperties.Name="Previous"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Today" Padding="10,6" Margin="6,0,0,0" Click="Today_Click" ToolTip="Back to today (Home)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="&#x25B6;" Padding="10,6" Margin="6,0,0,0" Click="Next_Click" ToolTip="Later (Right arrow)" AutomationProperties.Name="Next"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <DatePicker x:Name="GoToDatePicker" Width="140" Margin="10,0,0,0" VerticalAlignment="Center" SelectedDateChanged="GoToDate_Changed"
                            AutomationProperties.Name="Go to date" ToolTip="Select a date to go to"/>
                <TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <WrapPanel Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <RadioButton x:Name="MonthRadio" Content="Month" GroupName="CalendarMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="Mode_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="A month of days, with each day's tasks"/>
                    <RadioButton x:Name="WeekRadio" Content="Week" GroupName="CalendarMode" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="Mode_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="A week, with every task of each day"/>
                    <RadioButton x:Name="DayRadio" Content="Day" GroupName="CalendarMode" VerticalAlignment="Center"
                                 Checked="Mode_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="One day, with every task and its time"/>
                </StackPanel>
                <Button Content="New Task..." Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center" Click="NewTask_Click" ToolTip="Add a task (Ctrl+N). Double-click a day to add one due that day."
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="FiltersButton" Content="Filters..." Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center" Click="Filters_Click"
                        ToolTip="Show only some projects, goals, people, priorities or flags. The same filters as the Gantt view."
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="UndoButton" Content="Undo" Padding="10,4" Margin="0,0,24,0" VerticalAlignment="Center" Click="Undo_Click" IsEnabled="False"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="WeekendsCheckBox" Content="Weekends" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Option_Changed" Unchecked="Option_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Show Saturday and Sunday"/>
                <CheckBox x:Name="IncludeDoneCheckBox" Content="Include Done tasks" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Option_Changed" Unchecked="Option_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Show finished tasks as well"/>
                <CheckBox x:Name="NoDueCheckBox" Content="No Due Date list" IsChecked="True" VerticalAlignment="Center"
                          Checked="Option_Changed" Unchecked="Option_Changed" Foreground="{DynamicResource PrimaryTextBrush}"
                          ToolTip="A list beside the calendar of the tasks that have no due date. Drag one onto a day to give it that due date."/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="WeekdayHeader" Grid.Row="0"/>
                <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="BodyScroll_SizeChanged">
                    <Grid x:Name="CalendarGrid"/>
                </ScrollViewer>
            </Grid>

            <Border x:Name="NoDuePanel" Grid.Column="1" Width="250" Margin="12,0,0,0" CornerRadius="6" Padding="8"
                    Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="No Due Date" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="NoDueCountText" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ListBox x:Name="NoDueList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="NoDueList_PreviewMouseLeftButtonDown" PreviewMouseMove="NoDueList_PreviewMouseMove"
                             MouseDoubleClick="NoDueList_MouseDoubleClick" PreviewMouseRightButtonUp="NoDueList_PreviewMouseRightButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding ProjectName}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Help" Width="60" Padding="0,6" HorizontalAlignment="Left" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Open Help at the section about the Calendar. (F1)"/>
            <Button Content="Close" Width="90" Padding="0,6" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close this window. (Esc)"/>
        </Grid>
    </Grid>
</Window>
