<Window x:Class="KanbanApp.Views.ManageListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Manage" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <!-- One screen for Manage Projects, Goals, Flags and Who; ManagedListKind says which, with its
         title, wording and actions. The email line under each name shows only for people. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="NewNameTextBox" Width="220" Padding="6"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Content="Add" Width="80" Margin="8,0,0,0" Padding="0,6" Click="Add_Click" ToolTip="Add the name typed on the left" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Padding="6" Margin="0,0,8,0"
                                             Text="{Binding Name, Mode=OneWay}"
                                             LostFocus="Name_LostFocus"
                                             Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="Active" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  ToolTip="{Binding ActiveToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Checked="Active_Changed" Unchecked="Active_Changed"/>
                                        <!-- Goals only: finished. It drops out of the pickers and the Goal filter, and the Timeline hides it
                                             unless Include Done tasks is ticked. -->
                                        <CheckBox Content="Complete" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Visibility="{Binding CompleteVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                                  ToolTip="The goal is finished. It is no longer offered for new tasks or the Goal filter, and the Timeline hides it unless Include Done tasks is ticked. Its tasks keep it. Untick to open it again."
                                                  Checked="Complete_Changed" Unchecked="Complete_Changed"/>
                                    </StackPanel>
                                    <!-- Goals only: when work starts and when it should be finished (both optional), and its milestones. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0"
                                                Visibility="{Binding TargetVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <DatePicker Width="130" Padding="4" Loaded="TargetPicker_Loaded" SelectedDate="{Binding StartDate, Mode=OneWay}"
                                                    SelectedDateChanged="Start_Changed"
                                                    ToolTip="When work begins (optional). On the Timeline its bar starts here if that is before its first task."/>
                                        <Button Content="&#x2715;" Padding="6,4" Margin="3,0,0,0" Click="ClearStart_Click" ToolTip="Take the start date off"
                                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Target" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <DatePicker Width="130" Padding="4" Loaded="TargetPicker_Loaded" SelectedDate="{Binding TargetDate, Mode=OneWay}"
                                                    SelectedDateChanged="Target_Changed"
                                                    ToolTip="When this should be finished (optional). Shown on the Timeline, which flags one whose open tasks run past it."/>
                                        <Button Content="&#x2715;" Padding="6,4" Margin="3,0,0,0" Click="ClearTarget_Click" ToolTip="Take the target date off"
                                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Button Content="Milestones..." Padding="10,4" Margin="12,0,0,0" Click="Milestones_Click"
                                                ToolTip="The dated milestones on the way to this one. Each is drawn on the Timeline when it is grouped the same way."
                                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Delete" Padding="10,4" Click="Delete_Click" ToolTip="Take it off the list"
                                            Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Grid>
                                <TextBox Padding="6" Margin="0,4,0,0"
                                         Visibility="{Binding EmailVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Text="{Binding Email, Mode=OneWay}"
                                         LostFocus="Email_LostFocus"
                                         ToolTip="Email address (optional) - lets you email this person's tasks to them directly from a card"
                                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- Every add, rename and delete is saved as it happens, so there is nothing left to save here. -->

        <Button Content="Help" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Help for this window. (F1)" Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        <Button Grid.Row="2" Content="Close" Width="90" Padding="0,6" Margin="0,12,0,0"
                HorizontalAlignment="Right" IsCancel="True"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close this window. (Esc)"/>
    </Grid>
</Window>
