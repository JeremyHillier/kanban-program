<Window x:Class="KanbanApp.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanApp.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Timeline" Height="700" Width="1100" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Timeline" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PrevButton" Padding="10,6" Click="Prev_Click" ToolTip="Earlier (Left arrow)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Today" Padding="10,6" Margin="6,0,0,0" Click="Today_Click" ToolTip="Back to today (Home)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="NextButton" Padding="10,6" Margin="6,0,0,0" Click="Next_Click" ToolTip="Later (Right arrow)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <WrapPanel Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <RadioButton x:Name="MonthViewRadio" Content="Month view" GroupName="ZoomLevel" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="ZoomLevel_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="One column a month, for as many months as chosen beside it"/>
                    <ComboBox x:Name="MonthsComboBox" Width="58" Padding="6,3" Margin="-4,0,16,0" VerticalAlignment="Center"
                              IsEnabled="{Binding IsChecked, ElementName=MonthViewRadio}" SelectionChanged="Months_Changed"
                              ToolTip="How many months Month view shows"/>
                    <RadioButton x:Name="WeekViewRadio" Content="Week view" GroupName="ZoomLevel" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="ZoomLevel_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Twelve weeks, one column a week"/>
                    <RadioButton x:Name="DayViewRadio" Content="Day view" GroupName="ZoomLevel" VerticalAlignment="Center"
                                 Checked="ZoomLevel_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Three weeks, one column a day"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <RadioButton x:Name="SummaryRadio" Content="Summary" GroupName="Detail" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="Mode_Changed" Foreground="{DynamicResource PrimaryTextBrush}"
                                 ToolTip="One bar for each project or goal, from the first date of its open tasks to the last. Click a name or bar to show its tasks."/>
                    <RadioButton x:Name="DetailRadio" Content="Detail" GroupName="Detail" VerticalAlignment="Center"
                                 Checked="Mode_Changed" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Every task, with its dates"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Group by" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <RadioButton x:Name="ByProjectRadio" Content="Project" GroupName="GroupBy" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Checked="GroupBy_Changed" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <RadioButton x:Name="ByGoalRadio" Content="Goal" GroupName="GroupBy" VerticalAlignment="Center"
                                 Checked="GroupBy_Changed" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>

                <Button Content="New Task..." Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center" Click="NewTask_Click"
                        ToolTip="Add a task without leaving the Timeline (Ctrl+N)"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="FiltersButton" Content="Filters..." Padding="10,4" Margin="0,0,28,0" VerticalAlignment="Center" Click="Filters_Click"
                        ToolTip="Show only some projects, goals, people, priorities or flags"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <CheckBox x:Name="IncludeDoneCheckBox" Content="Include Done tasks" VerticalAlignment="Center"
                          Checked="IncludeDoneCheckBox_Changed" Unchecked="IncludeDoneCheckBox_Changed"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          ToolTip="Show finished tasks among the tasks. Summary bars always cover open tasks only."/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Frozen date-header row: its own ScrollViewer with no visible scrollbars, driven
                 programmatically to track the body's horizontal offset (see BodyScrollViewer_ScrollChanged)
                 so the header columns stay lined up with the body's while only the body scrolls vertically. -->
            <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="HeaderGrid"/>
            </ScrollViewer>

            <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="BodyScrollViewer_ScrollChanged">
                <Grid x:Name="TimelineGrid"/>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Help" Command="{x:Static views:HelpKey.ShowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Help for this window. (F1)"  HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Print" Width="90" Padding="0,6" Click="Print_Click" ToolTip="Print the timeline as shown"
                        Background="#FF66BB6A" Foreground="White"/>
                <Button Content="Close" Width="90" Padding="0,6" Margin="8,0,0,0"
                        IsCancel="True" IsDefault="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close this window. (Esc)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
