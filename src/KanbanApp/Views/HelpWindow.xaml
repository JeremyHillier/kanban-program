<Window x:Class="KanbanApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:KanbanApp.Views"
        mc:Ignorable="d"
        Title="Help" Height="820" Width="900" MinHeight="500" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="HelpSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HelpSubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextStrongBrush}"/>
        </Style>
        <Style TargetType="local:BulletItem">
            <Setter Property="Margin" Value="12,2,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The header band, as on the board: the heading, and the version at the right. -->
        <Border Grid.Row="0" Background="{DynamicResource AccentPanelBrush}" BorderBrush="{DynamicResource AccentPanelBorderBrush}"
                BorderThickness="0,0,0,2" CornerRadius="4" Padding="16,10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12" Foreground="White" Opacity="0.8" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeadingText" Text="HELP" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
            <TabItem Header="How it works">
        <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" Padding="16,8">
            <StackPanel x:Name="ContentPanel" MaxWidth="780" HorizontalAlignment="Left">
                <local:BulletItem Text="Tasks sit in five columns: To Do, In Progress, On Hold, Waiting and Done. You can rename them."/>
                <local:BulletItem Text="Drag a card to another column, or use its move buttons."/>
                <local:BulletItem Text="Each move button shows a letter from its column's name. The tick is always Done."/>

                <TextBlock Text="Quick keys" Style="{StaticResource HelpSectionHeaderStyle}" Margin="0,2,0,4"/>
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Main screen" FontWeight="SemiBold" Margin="0,6,0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Ctrl+N" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="New task" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Text="Ctrl+Alt+N" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Quick Add, from any program" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Text="Ctrl+F" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Go to the Keyword filter" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Text="Ctrl+Z" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Undo the last change to a task. In a text box, it undoes typing" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="4" Text="Ctrl+P" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Report Builder" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="5" Text="Ctrl+Shift+P" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Quick Report" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="6" Text="Ctrl+Q" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Close the program" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="7" Text="Alt+A" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Archive done tasks" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="8" Text="Alt+P, Alt+G, Alt+F, Alt+W" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Manage Projects, Goals, Flags or Who" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="9" Text="Alt+M" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="Manage task templates" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="10" Text="Alt+R" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Reminders" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="11" Text="Alt+S" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="Settings" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="12" Text="Alt+L" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="Timeline" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="13" Text="Alt+H" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="Help" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="14" Text="Alt+B" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="Hide or show the button column" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="15" Text="Alt+U" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="15" Grid.Column="1" Text="Hide or show the buttons on the cards" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="16" Text="Alt+T" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="16" Grid.Column="1" Text="Only what is due today or overdue" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="17" Text="Alt+0 to Alt+9" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="17" Grid.Column="1" Text="Apply a saved custom filter" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="18" Text="Ctrl+click, Shift+click" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="18" Grid.Column="1" Text="Pick cards, or a range of them in one column" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="19" Text="Delete" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="19" Grid.Column="1" Text="Delete the picked cards, after asking" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="20" Text="Esc" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="20" Grid.Column="1" Text="Clear the selection, then the filters" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="21" Text="Double-click" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="21" Grid.Column="1" Text="Edit a card; on a column heading, add a task there" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <TextBlock Text="Every window" FontWeight="SemiBold" Margin="0,6,0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="F1" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Help, at the section about that window" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Text="Enter" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="The main button" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Text="Esc" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Cancel or Close" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Text="Ctrl+S" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Save and Close, in the task and settings windows" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="4" Text="Alt+underlined letter" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Press that button" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="5" Text="Ctrl+C" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="In a message, copy the message" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,6,0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Left, Right" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Earlier or later" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Text="Home" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Back to today" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                        <TextBlock Text="Lists: priorities, templates, Waiting On answers, custom filters" FontWeight="SemiBold" Margin="0,6,0,2" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="F2" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Rename" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Text="Delete" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Delete, after asking" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Text="Alt+Up, Alt+Down" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Move a priority up or down the list" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Text="Shift+Delete" FontFamily="Consolas" Margin="10,1,0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="On a Waiting On suggestion, stop it being suggested" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HelpSection_AddEditTask" Text="Adding and editing tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Text="Creating" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="New Task, or Ctrl+N, creates a task."/>
                <local:BulletItem Text="Double-click a column heading to create a task in that column."/>
                <local:BulletItem Text="Double-click a card to edit it."/>
                <local:BulletItem Text="Project is required. Everything else is optional."/>
                <local:BulletItem Text="When editing, the green check mark beside Save and Close saves your changes and finishes the task."/>
                <TextBlock Text="Dates and times" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="A due time needs a due date. Type it as 2:30 PM, 2pm or 14:30."/>
                <local:BulletItem Text="Clearing the date clears the time."/>
                <local:BulletItem Text="The AM and PM buttons set or switch the half of the day."/>
                <local:BulletItem Text="A time without AM or PM is read as a working hour: 7 to 11 AM, 12 to 6 PM."/>
                <local:BulletItem Text="A Start date means the task cannot be worked on before then."/>
                <local:BulletItem Text="Until that date, the card shows Starts and the date."/>
                <local:BulletItem Text="The start date cannot be after the due date."/>
                <local:BulletItem Text="Recurring tasks carry the time, and the gap from start to due, to each new occurrence."/>
                <TextBlock Text="People" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="+ adds a new Project, Goal or person. − clears the choice without deleting it."/>
                <local:BulletItem Text="Tick several people in Who to share a task."/>
                <local:BulletItem Text="The first person ticked is the lead. Click make lead to change it."/>
                <local:BulletItem Text="Type a first name or surname to jump to that person. Space ticks them."/>
                <local:BulletItem Text="The board's Project, Priority and Who filter lists also jump as you type."/>
                <local:BulletItem Text="A shared task lists everyone on the card, lead first."/>
                <TextBlock Text="Also on the task screen" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Link takes a web address, an email address, or a file or folder. Open launches it."/>
                <local:BulletItem Text="Browse picks a file or folder. Or drag one onto the box, or paste its path."/>
                <local:BulletItem Text="A file opens in its usual app, and a folder opens in Explorer."/>
                <local:BulletItem Text="Programs and scripts (.exe, .bat, .ps1 and the like) are never allowed."/>
                <local:BulletItem Text="A network path asks first, because opening it tells that computer who you are."/>
                <local:BulletItem Text="A file path only works on a PC that has the file, so a link sent to someone else may not open."/>
                <local:BulletItem Text="Links to files, folders or programs are refused, for your safety."/>
                <local:BulletItem Text="Closing with unsaved changes asks first."/>
                <local:BulletItem Text="Spell check accepts Canadian and American spellings."/>
                <local:BulletItem Text="Right-click a flagged word for suggestions, Ignore All, or Add to Dictionary."/>
                <local:BulletItem Text="Ignore All lasts only while that box is open. Add to Dictionary is kept for good."/>
                <local:BulletItem Text="Your words are in Settings, one per line. Take one out to have it flagged again."/>
                <local:BulletItem Text="They are kept in the task file, so every PC using it has them."/>
                <local:BulletItem Text="A word added in lower case is accepted in any capitals; one with a capital only as written."/>
                <local:BulletItem Text="Auto-correct fixes common slips like teh as you finish a word, in the task and notes boxes."/>
                <local:BulletItem Text="Press Ctrl+Z straight after a correction to put back what you typed."/>
                <local:BulletItem Text="Settings turns it off and takes your own corrections, one per line, like kbp = Kanban Program."/>
                <local:BulletItem Text="A slip at the very end of the box is fixed when you click away or save."/>

                <TextBlock Text="Emailing a task" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="The envelope button shows when the person has an email address, set in Manage Who."/>
                <local:BulletItem Text="The email holds the task's details. Nothing is sent until you click Send."/>
                <local:BulletItem Text="A shared task's email goes to everyone with an address."/>
                <local:BulletItem Text="An Excel copy goes with it. Other Kanban Task Board users can import it."/>
                <local:BulletItem Text="It carries the whole task: repeating, due time, notes, sub-tasks, flags and link."/>
                <local:BulletItem Text="A repeating task keeps repeating on their board, with the same number of times left."/>
                <local:BulletItem Text="If they change it and email it back, importing it updates your task rather than adding a copy."/>
                <TextBlock Text="Sending a task back" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="A task someone sent you remembers who sent it. Their name and address come from their Settings, Your Details."/>
                <local:BulletItem Text="Right-click it, Send Back, or use Send Back on the task screen, to email it to them with its status."/>
                <local:BulletItem Text="Status is the column: To Do, In Progress, On Hold, Waiting or Done, whatever each person has renamed them."/>
                <local:BulletItem Text="Marking a task they sent you Done offers to email them. Settings can switch that off."/>
                <local:BulletItem Text="With classic Outlook, files are attached and your signature is kept."/>
                <local:BulletItem Text="With no Outlook signature, one is built from Settings, Your Details."/>
                <local:BulletItem Text="With another email app, a folder opens with the files to drag into the email."/>
                <local:BulletItem Text="The task remembers each time it was emailed. Open it to see when, and to whom."/>
                <local:BulletItem Text="Point at that line for every time. It records the email being opened, not sent."/>
                <TextBlock Text="Several tasks in one email" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Right-click a task, Email All ... Tasks, for every open task of its project in one email."/>
                <local:BulletItem Text="Tasks in Done are left out of it."/>
                <local:BulletItem Text="Or select tasks with Ctrl+click, right-click them, and choose Email These Tasks."/>
                <local:BulletItem Text="It goes to everyone on the tasks with an email address. Change that in the email as you like."/>
                <local:BulletItem Text="The email lists the tasks; one Excel file with all of them is attached, ready to import."/>
                <local:BulletItem Text="Sent back after changes, they update your tasks rather than adding copies."/>
                <local:BulletItem Text="Files attached to the tasks are not included. Email a task on its own to send its files."/>

                <TextBlock Text="Scheduling a task in Outlook" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Right-click a task, Schedule in Outlook, for an appointment in your calendar."/>
                <local:BulletItem Text="Large cards have a calendar button too; so does the task screen, as Schedule."/>
                <local:BulletItem Text="It goes at the due time for half an hour, or all day on the due date if there is no time."/>
                <local:BulletItem Text="With no due date, it goes at the next half hour. Move it in Outlook as you like."/>
                <local:BulletItem Text="The task's details and attachments go in it. Nothing is saved until you save it in Outlook."/>
                <local:BulletItem Text="Without classic Outlook, it opens as a calendar file in your calendar app."/>
                <local:BulletItem Text="The task screen shows when it was last scheduled, and for when."/>
                <TextBlock Text="Link back to the task" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="The event has an Open in Kanban Task Board link. Click it to open that task here."/>
                <local:BulletItem Text="Emails about a task carry the same link, and a group email links each task by its title."/>
                <local:BulletItem Text="The app opens, or comes forward if it is open, shows the task highlighted and opens it."/>
                <local:BulletItem Text="Filters that would hide the task are cleared so it can be seen."/>
                <local:BulletItem Text="A task that was archived or deleted says so, and when, instead."/>
                <local:BulletItem Text="It only works on a PC with the app, and only for the task file it came from."/>
                <local:BulletItem Text="Outlook may ask before opening a link of this kind. Choose to allow it."/>
                <local:BulletItem Text="Every task has a permanent ID, which is what the link is made of. It holds nothing else."/>
                <local:BulletItem Text="Right-click a task, Copy Link, to paste its link into a note, a chat or any email."/>

                <TextBlock x:Name="HelpSection_QuickAdd" Text="Quick Add from any program" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Press Ctrl+Alt+N in any program for a small New Task box."/>
                <local:BulletItem Text="The app must be running. Minimised is fine."/>
                <local:BulletItem Text="Type the task and press Enter. The box stays open for more; Esc closes it."/>
                <local:BulletItem Text="New tasks go into the first column, at the default priority, in the project shown beside the box."/>
                <local:BulletItem Text="Priority: add ! and the start of its name, such as !high or !h."/>
                <local:BulletItem Text="Who: add @ and the start of a name, such as @sam."/>
                <local:BulletItem Text="Due date: add /today, /tomorrow, /fri, /+3 or /10-15."/>
                <local:BulletItem Text="The line under the box shows how it was read, before you press Enter."/>
                <local:BulletItem Text="Anything else stays in the title, so an email address or 50/50 is safe."/>
                <local:BulletItem Text="Settings shows if another program already uses Ctrl+Alt+N, and can switch Quick Add off."/>

                <TextBlock x:Name="HelpSection_TaskTemplates" Text="Task templates" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="A template is a saved starting point for a task you create often."/>
                <local:BulletItem Text="It keeps the project, priority, who, goal, flags, sub-tasks, notes, link and recurring settings."/>
                <local:BulletItem Text="To save one: Save as Template on the task screen, or right-click a card."/>
                <local:BulletItem Text="To use one: pick it from the Template list, or right-click New Task."/>
                <local:BulletItem Text="Everything it fills in can still be changed."/>
                <local:BulletItem Text="Dates are kept as days from today. Due in 14 days stays due in 14 days."/>
                <local:BulletItem Text="Not kept: past dates, attachments, Waiting On, the column and sub-task ticks."/>
                <local:BulletItem Text="To rename or delete one: Alt+M, or Manage beside the Template list."/>
                <local:BulletItem Text="Deleting a template does not affect tasks made from it."/>

                <TextBlock Text="Sub-tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Add sub-task rows on the task screen, each with its own tickbox."/>
                <local:BulletItem Text="Large cards show the tickboxes, so they can be ticked on the board."/>
                <local:BulletItem Text="The task screen and the card show how many are done, with a percentage."/>

                <TextBlock Text="Attachments" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="+ File copies a file into the Attachments folder beside your task file."/>
                <local:BulletItem Text="The original file is left untouched."/>
                <local:BulletItem Text="Drag a file from Explorer, Outlook or an email onto a card or the attachments area."/>
                <local:BulletItem Text="Paste Screenshot attaches the picture on the clipboard."/>
                <local:BulletItem Text="Click a thumbnail or file name to open it."/>
                <local:BulletItem Text="A program or script asks before it opens. Enter leaves it unopened."/>
                <local:BulletItem Text="Right-click an attachment to open it, show its folder, copy it, save a copy or remove it."/>
                <local:BulletItem Text="× removes an attachment and deletes its saved copy."/>
                <local:BulletItem Text="Attachments move with the task into Done, Archived and Deleted folders, and back again."/>

                <TextBlock x:Name="HelpSection_RecurringTasks" Text="Recurring tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Tick Recurring and pick a pattern, from Daily to Annually."/>
                <local:BulletItem Text="To stop after a number of times, enter it under the pattern, counting this task."/>
                <local:BulletItem Text="Leave it empty, shown as ∞, to repeat with no end."/>
                <local:BulletItem Text="The card shows how many are still to come."/>
                <local:BulletItem Text="Moving a recurring task to Done creates the next one in To Do, with sub-tasks unticked."/>
                <local:BulletItem Text="Each task creates its next occurrence only once, even if finished again later."/>
                <local:BulletItem Text="Deleting an unfinished recurring task asks: blue keeps the series going, red ends it."/>
                <TextBlock Text="Days of month" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Repeats every day within part of each month, then waits for the next month."/>
                <local:BulletItem Text="Choose Days for dates of the month: Days 5 to 12 is the 5th to the 12th."/>
                <local:BulletItem Text="Choose Working days to count Monday to Friday: Working days 1 to 10 is the first ten."/>
                <local:BulletItem Text="Public holidays are not known, so they count as working days."/>
                <local:BulletItem Text="Finishing one brings back the next day. Fall behind and it comes back for today instead."/>
                <local:BulletItem Text="The count under it is in months: for 6 months, then it stops."/>
                <local:BulletItem Text="A due date outside the days chosen moves to the next day inside them."/>
                <local:BulletItem Text="A short month stops at its end; a month the days don't reach is skipped."/>
                <TextBlock Text="Semi-Monthly" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Twice a month, on the same two dates."/>
                <local:BulletItem Text="Due on the 1st to 15th: that day and 15 days later, so the 3rd gives the 3rd and 18th."/>
                <local:BulletItem Text="Due on the 16th or later: that day and 15 days earlier, so the 20th gives the 5th and 20th. The last day of a month pairs with the 15th."/>

                <TextBlock Text="Quick actions on a card" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="The letter buttons move a card to To Do, In Progress, On Hold or Waiting."/>
                <local:BulletItem Text="The check mark moves it to Done. X deletes it."/>
                <local:BulletItem Text="Or right-click a task and choose Mark as Done, at the top of the menu. With several selected, Mark All as Done."/>
                <local:BulletItem Text="The tag icon adds a flag."/>
                <local:BulletItem Text="Click the project, priority, person or due date to change it on the board."/>
                <local:BulletItem Text="The due date opens a month calendar: click a day, Today, or Clear Due Date."/>
                <local:BulletItem Text="Over any calendar, the mouse wheel moves between months."/>
                <local:BulletItem Text="In the right-click menu, point at Set Due Date and the calendar opens beside it, for one card or every picked card."/>
                <local:BulletItem Text="Right-click a card for everything else: copy, duplicate, move, assign, email and more."/>
                <local:BulletItem Text="Copy as Text copies the whole task, ready to paste anywhere."/>
                <local:BulletItem Text="Duplicate copies every detail except attached files, with sub-tasks unticked."/>
                <local:BulletItem Text="Past-due tasks show their title and due date in yellow."/>
                <local:BulletItem Text="The stamp at the bottom shows the last update, or when it was completed."/>

                <TextBlock x:Name="HelpSection_WaitingOn" Text="Waiting On" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Say who or what a task is held up by, such as Sam's quote."/>
                <local:BulletItem Text="Leave it empty when nothing is holding it up."/>
                <local:BulletItem Text="The card shows it in a highlighted line. Click the line to change it."/>
                <local:BulletItem Text="Right-click cards and choose Waiting On to set or clear it without opening them."/>
                <local:BulletItem Text="Moving a task into Waiting asks what it is waiting on, unless it already says."/>
                <local:BulletItem Text="Skip moves it without saying. Add it later from the card."/>
                <local:BulletItem Text="Finishing a task clears it."/>
                <local:BulletItem Text="The Waiting On button shows every waiting task, across all columns."/>
                <local:BulletItem Text="The Waiting filter shows the tasks waiting on one answer, alongside your other filters."/>
                <local:BulletItem Text="Keyword search, Copy as Text, emails, reports and Excel files all include it."/>
                <TextBlock Text="Suggestions" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Past answers are suggested as you type. Enter takes the suggestion."/>
                <local:BulletItem Text="Backspace removes the suggestion. Up and Down move through the list."/>
                <local:BulletItem Text="Shift+Delete stops a highlighted answer being suggested."/>
                <local:BulletItem Text="To manage the list, click Manage list in the prompt, or List on the task screen."/>
                <local:BulletItem Text="Renaming an answer rewords it on every task."/>
                <local:BulletItem Text="Deleting an answer in use asks whether to clear it from those tasks too."/>

                <TextBlock Text="Undo" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Ctrl+Z, or Undo beside New Task, takes back the last change to a task."/>
                <local:BulletItem Text="Hover over Undo to see what it will take back."/>
                <local:BulletItem Text="It covers adding, editing, moving, deleting, Archive Done, importing and quick card changes."/>
                <local:BulletItem Text="A change to several selected tasks is undone in one go."/>
                <local:BulletItem Text="Undoing a recurring task's completion removes the next occurrence too."/>
                <local:BulletItem Text="The last 30 actions are kept until the app closes. There is no redo."/>
                <local:BulletItem Text="Not covered: the Manage lists, Settings, attachments, and the Archived and Deleted screens."/>

                <TextBlock x:Name="HelpSection_ProjectsGoals" Text="Projects, Goals, Flags and Who" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="The Manage screens add, rename or delete entries."/>
                <local:BulletItem Text="Click the coloured label beside a filter to open its Manage screen."/>
                <local:BulletItem Text="A task can carry several flags."/>
                <local:BulletItem Text="Click a task's goal line, or right-click it and choose Goal, to change its goal."/>
                <local:BulletItem Text="Lists are always alphabetical."/>
                <local:BulletItem Text="Untick Active to retire an entry. Tasks already using it keep it."/>
                <local:BulletItem Text="Names are unique, whatever their capitals."/>
                <local:BulletItem Text="Adding a name already there uses it, and switches it back on if needed."/>
                <local:BulletItem Text="Delete says how many tasks use the entry first. It cannot be undone."/>

                <TextBlock Text="Sorting and filtering" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Text="Sorting" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Click a sort button to sort by it alone."/>
                <local:BulletItem Text="Ctrl+click more buttons to combine them. A number shows each one's order."/>
                <local:BulletItem Text="Ctrl+click an active button again to remove it."/>
                <local:BulletItem Text="Drag a card within its column to place it by hand. The order is kept until you sort again."/>
                <TextBlock Text="Selecting several cards" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Ctrl+click to pick cards. Shift+click picks a range in one column."/>
                <local:BulletItem Text="Drag any picked card to move them all together."/>
                <local:BulletItem Text="Right-click a picked card for actions on all of them."/>
                <local:BulletItem Text="A tick in a submenu means every picked task already has it."/>
                <local:BulletItem Text="In Assign To, each person switches on or off without changing the others."/>
                <local:BulletItem Text="Esc, or a plain click on another card, clears the selection."/>
                <local:BulletItem Text="Moving several to Done skips the completion note question."/>
                <TextBlock x:Name="HelpSection_Priorities" Text="Priorities" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Click the Priority label beside the filter list to open the priority list."/>
                <local:BulletItem Text="It is also in Settings, and under Priority when you right-click a card."/>
                <local:BulletItem Text="Add priorities of your own, such as Urgent or Someday."/>
                <local:BulletItem Text="Rename one, and every task that has it is reworded, archived tasks too."/>
                <local:BulletItem Text="Move Up and Move Down set the order. The top one is the highest."/>
                <local:BulletItem Text="Menus, the filter list, reports and Sort by Priority all use that order."/>
                <local:BulletItem Text="Colour sets the badge colour on cards, the Timeline and the Dashboard."/>
                <local:BulletItem Text="Make Default chooses the priority a new task starts with."/>
                <local:BulletItem Text="Delete moves its tasks to the default priority. The default cannot be deleted."/>
                <local:BulletItem Text="Renaming or deleting a priority clears the Undo history."/>
                <TextBlock Text="Filters" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Filter by project, priority, who, goal, flag, waiting on, due date or keyword."/>
                <local:BulletItem Text="While anything is filtering, a line under the title at the top says what, and how many tasks show."/>
                <local:BulletItem Text="It names a saved filter the board matches, and says when future tasks are hidden."/>
                <local:BulletItem Text="Project, Priority and Who take several choices: Ctrl+click or Shift+click."/>
                <local:BulletItem Text="Unassigned shows tasks with no person, goal or flag, or not waiting on anything."/>
                <local:BulletItem Text="Waiting lists the answers on your tasks. Any shows every waiting task."/>
                <local:BulletItem Text="Drag the bar under the lists to resize them. Double-click it to reset."/>
                <local:BulletItem Text="Today, Tomorrow, Within a Week and No Due Date clear the other filters first."/>
                <local:BulletItem Text="Today and Within a Week include overdue tasks."/>
                <local:BulletItem Text="These buttons also show tasks starting in that period."/>
                <local:BulletItem Text="From and To set a due date range. Leave either end blank to leave it open."/>
                <local:BulletItem Text="Hide Future hides tasks until their start date, and shows how many are hidden."/>
                <local:BulletItem Text="Clear Filters resets every filter to All."/>

                <TextBlock x:Name="HelpSection_CustomFilters" Text="Custom filters (Alt+0 to Alt+9)" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Ten slots hold filter combinations you use often."/>
                <local:BulletItem Text="Set the filters, click Custom Filters, pick a slot and save it under a name."/>
                <local:BulletItem Text="Press Alt and the slot's number to apply it. The number row and keypad both work."/>
                <local:BulletItem Text="The Custom Filters window renames, applies or clears slots."/>
                <local:BulletItem Text="An empty slot's key does nothing."/>
                <local:BulletItem Text="Hover over Custom Filters to see every slot."/>

                <TextBlock x:Name="HelpSection_ArchivingDeleting" Text="Archiving and deleting" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Archive Done moves every task in Done off the board."/>
                <local:BulletItem Text="Deleted tasks are kept out of sight, not erased."/>
                <local:BulletItem Text="View Archived shows archived tasks. Double-click it for deleted tasks."/>
                <local:BulletItem Text="Select a task in either list and reactivate it back to To Do."/>
                <local:BulletItem Text="In the Archived list, double-clicking a task reactivates it."/>
                <local:BulletItem Text="Archived tasks show when they were completed and archived."/>
                <local:BulletItem Text="From and To narrow either list by date. Clear Dates resets it."/>
                <local:BulletItem Text="Right-click, Permanently Delete erases a task and its attachments. There is no undo."/>

                <TextBlock x:Name="HelpSection_ImportingTasks" Text="Importing tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Import Tasks reads an Excel .xlsx file. Download Template gives one laid out the right way."/>
                <local:BulletItem Text="Or drop the file on the Import Tasks window, from a folder or from Outlook."/>
                <local:BulletItem Text="From Outlook, drop the attachment itself or the whole email; the Excel file inside is used."/>
                <local:BulletItem Text="A task emailed from the app comes with an Excel file attached, ready to drop."/>
                <local:BulletItem Text="The tasks found are listed for a yes before anything is imported."/>
                <local:BulletItem Text="Only Title is required."/>
                <local:BulletItem Text="Your own spreadsheet works too, with headings on any row, in any order."/>
                <local:BulletItem Text="Other headings understood include Task, Status, Due, Assigned To and Start."/>
                <local:BulletItem Text="For several people, separate names with semicolons. The first is the lead."/>
                <local:BulletItem Text="Dates are MM/DD/YYYY. The year is optional."/>
                <local:BulletItem Text="Optional columns: Due Time, Repeats, Repeat Times, Flags, Link (or Website), Notes and Sub-tasks."/>
                <local:BulletItem Text="Sub-tasks go one per line in their cell; start a line [x] for one already done."/>
                <local:BulletItem Text="New projects, goals, people and flags in the file are added."/>
                <local:BulletItem Text="A task you already have is updated, not added again. The list before importing says which."/>
                <local:BulletItem Text="The app knows it by the Task ID column. Leave that column alone."/>
                <local:BulletItem Text="A task you have archived or deleted comes back as a new task."/>
                <local:BulletItem Text="A task changed on both sides asks you: Use Theirs, Keep Mine (Esc), or Keep Both."/>
                <local:BulletItem Text="Keep Both adds theirs as a separate task, marked (theirs), with no link to yours."/>
                <local:BulletItem Text="A copy that only came back unchanged leaves your newer edits alone."/>
                <local:BulletItem Text="After import, a list opens to fix up the new tasks."/>
                <local:BulletItem Text="Double-click Import Tasks to review tasks still marked Imported."/>

                <TextBlock x:Name="HelpSection_ReportBuilder" Text="Report Builder" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Report type: a Task list, or Statistics about your tasks."/>
                <TextBlock Text="Building a report" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Choose the columns, filters, grouping, sort, notes and sub-tasks."/>
                <local:BulletItem Text="Sort takes up to three levels."/>
                <local:BulletItem Text="Task scope: board tasks, board and archived, or archived only."/>
                <local:BulletItem Text="The archived From and To pick tasks by when they were archived."/>
                <local:BulletItem Text="Custom Filters: tick saved filters to include any task matching one."/>
                <local:BulletItem Text="The sub-task summary counts how often each sub-task was done. Useful for recurring tasks."/>
                <local:BulletItem Text="Grouped by Who, a shared task is listed under each person."/>
                <TextBlock Text="Statistics" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Pick a period: last 7 or 30 days, a month, quarter or year, all time, or your own dates."/>
                <local:BulletItem Text="Summary: added, finished, finished on time, typical days to finish, open and overdue now."/>
                <local:BulletItem Text="Breakdown: the same figures for each project, person, priority or goal."/>
                <local:BulletItem Text="Over time: tasks added and finished, week by week or month by month."/>
                <local:BulletItem Text="Time in each column: how long finished tasks spent in each column on the way to Done."/>
                <local:BulletItem Text="Typical is the middle value, so one long-forgotten task doesn't skew it."/>
                <local:BulletItem Text="Include charts adds a chart to each section, with a line on how to read it."/>
                <local:BulletItem Text="Charts: on time against late, how long tasks took, and finished and open by group."/>
                <local:BulletItem Text="Also: added against finished over time, and typical days in each column."/>
                <local:BulletItem Text="The filters apply. Archived tasks count; deleted ones don't."/>
                <local:BulletItem Text="A saved view keeps the period, so Last month is always last month."/>
                <TextBlock x:Name="HelpSection_ReportOutput" Text="Output" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Preview shows the pages, with zoom and Print."/>
                <local:BulletItem Text="PDF saves to the Default Export Path, or asks where."/>
                <local:BulletItem Text="Choose Portrait or Landscape."/>
                <local:BulletItem Text="The heading lists the filters, sort and scope used, with task counts by status."/>
                <TextBlock Text="Saved views" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Save View stores every choice under a name. Load rebuilds the report."/>
                <local:BulletItem Text="Saving under the loaded view's name updates it, after asking."/>
                <local:BulletItem Text="The Today buttons keep 'today' in a saved view, so it stays current."/>
                <local:BulletItem Text="Right-click a Today button for so many days from today."/>
                <local:BulletItem Text="Quick Report, Ctrl+Shift+P, runs a saved view in two clicks."/>
                <local:BulletItem Text="Standard reports come ready to run. Change or delete them like your own."/>
                <local:BulletItem Text="Reset all fields puts everything back to the defaults."/>

                <TextBlock x:Name="HelpSection_Dashboard" Text="Dashboard" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="The banner shows Open, Overdue, Due Today and Due This Week."/>
                <local:BulletItem Text="Double-click the banner for the full Dashboard."/>
                <local:BulletItem Text="Seven tiles and six charts cover status, due dates, completions, stalled work, projects and people."/>
                <local:BulletItem Text="Hover over a bar for its numbers."/>
                <local:BulletItem Text="The colours stay distinct for colour-blind readers, in light and dark mode."/>
                <local:BulletItem Text="It opens at the size and position it was left."/>

                <TextBlock x:Name="HelpSection_Timeline" Text="Timeline" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Alt+L shows tasks with dates: projects or goals down the side, dates across the top."/>
                <local:BulletItem Text="A task with a start date has a box at the start and an arrow to its due date."/>
                <local:BulletItem Text="A dashed box started before the dates shown. An arrow off the right is due later."/>
                <local:BulletItem Text="Month view shows 6 months. Week view shows 12 weeks. Day view shows 21 days."/>
                <local:BulletItem Text="Summary shows one bar per project or goal, from the first to the last date of its open tasks."/>
                <local:BulletItem Text="Beside each name: how many tasks are open, overdue (in red) and undated."/>
                <local:BulletItem Text="Click a name or its bar to show or hide its tasks. Detail shows every task."/>
                <local:BulletItem Text="Group by Project or Goal."/>
                <local:BulletItem Text="Page with the arrow buttons. Today jumps back."/>
                <local:BulletItem Text="Include Done tasks brings finished tasks back in."/>
                <local:BulletItem Text="Blocks use the priority colours. Hover for details; double-click to open."/>
                <local:BulletItem Text="Print previews what is showing, on landscape pages."/>
                <local:BulletItem Text="It opens at the size, view and grouping last used, in Summary the first time."/>

                <TextBlock x:Name="HelpSection_Reminders" Text="Reminders" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Opening the app lists anything overdue or due today."/>
                <local:BulletItem Text="Tick a task to mark it Done. Double-click to edit it."/>
                <local:BulletItem Text="Alt+R brings the list back any time."/>
                <TextBlock Text="Task Due Now alerts" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="A task with a due time alerts, with a sound, when the time comes."/>
                <local:BulletItem Text="Alerts need the app running. Minimised is fine."/>
                <local:BulletItem Text="Each task alerts once. Moving the time later alerts again."/>
                <local:BulletItem Text="Clear beside the time on the task screen removes the time and its alert."/>
                <local:BulletItem Text="Each task has its own Snooze, for 15 minutes up to 1 day."/>
                <local:BulletItem Text="With several tasks listed, Snooze All snoozes them all at once."/>
                <local:BulletItem Text="Completing or rescheduling a task cancels its snooze."/>
                <local:BulletItem Text="Times missed while the app was closed show in the startup list instead."/>

                <TextBlock Text="Display options" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Dark Mode or Light Mode switches the theme."/>
                <local:BulletItem Text="Large or Compact Cards sets how much each card shows."/>
                <local:BulletItem Text="Compact cards still show what a task is waiting on."/>
                <local:BulletItem Text="Hide Buttons, or Alt+U, takes the buttons off every card. Right-click a card for the same actions."/>
                <local:BulletItem Text="Hide, or Alt+B, folds the button column to a thin strip. Click the strip to bring it back."/>
                <local:BulletItem Text="While folded, the strip warns when filters are hiding tasks."/>
                <local:BulletItem Text="Compact buttons, in Settings, makes the button column smaller for small screens."/>
                <TextBlock Text="Small screens" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Columns fit the window down to 240 pixels each, then the board scrolls sideways."/>
                <local:BulletItem Text="In Settings, lower the narrowest a fitted column can get, down to 160, to fit more on."/>
                <local:BulletItem Text="In a narrow column, a card's buttons go onto two rows and its lesser details are left off."/>
                <local:BulletItem Text="Left off: goal, flags, attachments, the Updated line and the side buttons."/>

                <TextBlock x:Name="HelpSection_Settings" Text="Settings" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Text="How it works" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Changes show as you make them. Save &amp; Close keeps them."/>
                <local:BulletItem Text="Cancel puts every setting back, after asking."/>
                <local:BulletItem Text="Backups and task file changes happen straight away. Cancel does not undo them."/>
                <TextBlock Text="Board" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Rename any column. The last column still works as Done."/>
                <local:BulletItem Text="The letters on each card's move buttons follow the column names."/>
                <local:BulletItem Text="Use GTD Names sets Inbox, Next Actions, In Progress, Waiting and Done."/>
                <local:BulletItem Text="Use Standard Names puts the original names back."/>
                <local:BulletItem Text="Move the button panel to the right."/>
                <local:BulletItem Text="Fit the columns to the window, or set a fixed width of at least 240 pixels."/>
                <local:BulletItem Text="Turn the splash screen on or off, and set how long it shows."/>
                <local:BulletItem Text="Start when Windows starts opens the app when you sign in. It is set on each PC separately."/>
                <local:BulletItem Text="Start in full screen. The window size and position are remembered."/>
                <TextBlock Text="Prompts" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Ask before deleting, and before Archive Done."/>
                <local:BulletItem Text="Ask to add a note when a task reaches Done."/>
                <local:BulletItem Text="Startup reminders and Task Due Now alerts, on or off."/>
                <local:BulletItem Text="Remember filters, sort and search between sessions."/>
                <local:BulletItem Text="Show What's New after an update, or read it any time."/>
                <TextBlock Text="Files and details" Style="{StaticResource HelpSubHeaderStyle}"/>
                <local:BulletItem Text="Default folders for exports, imports and attachments."/>
                <local:BulletItem Text="Your Details sign task emails when Outlook has no signature."/>
                <local:BulletItem Text="Move the task file. The old copy is removed after the restart."/>
                <local:BulletItem Text="Keep the task file on this PC, not in a folder another computer syncs and opens."/>
                <local:BulletItem Text="An older copy of the app warns before opening a file a newer copy has used."/>

                <TextBlock Text="Task files" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Keep separate boards, such as work and personal, in separate task files."/>
                <local:BulletItem Text="Settings, Data Storage: New File starts an empty board. Open Existing File opens one."/>
                <local:BulletItem Text="Files used before are listed. Double-click one to switch to it."/>
                <local:BulletItem Text="Remove from List tidies the list. It does not delete the file."/>
                <local:BulletItem Text="Switching restarts the app. The file you leave is not changed."/>

                <TextBlock Text="Backups" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Closing the app saves a dated copy of the task file. The latest 20 are kept."/>
                <local:BulletItem Text="Settings, Backups: turn it off, change how many, back up now or open the folder."/>
                <local:BulletItem Text="To restore, close the app and copy the backup over the task file."/>
                <local:BulletItem Text="Move the current file aside first if you may want it back."/>
                <local:BulletItem Text="Backups cover tasks and settings. Attachments have their own folder."/>

                <TextBlock Text="Getting help" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="The ? button on a screen opens Help at its topic."/>
                <local:BulletItem Text="The What's New tab lists the changes in the last five versions."/>
                <local:BulletItem Text="It opens once after each update. To stop that, untick Show What's New in Settings."/>
                <local:BulletItem Text="Report a Problem emails support with the error log attached."/>
                <local:BulletItem Text="Nothing is sent until you click Send."/>
                <local:BulletItem Text="An unexpected error also offers to open that email."/>
                <local:BulletItem Text="About shows the version and where this installation keeps its files."/>

                <TextBlock Text="Updates" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Once a day, at start-up, the app checks for a newer version."/>
                <local:BulletItem Text="Get the Update opens the download page. The installer updates in place and keeps your tasks."/>
                <local:BulletItem Text="If the app is running, Setup offers to close it. It will not close while a task is being edited."/>
                <local:BulletItem Text="Remind Me Later waits a day. Skip This Version skips that version only."/>
                <local:BulletItem Text="The check sends only the app's name and version. Nothing downloads unless you choose."/>
                <local:BulletItem Text="To turn it off, untick 'Check for a newer version automatically' in Settings."/>
                <local:BulletItem Text="To check any time, click Check for Updates in About."/>
                <local:BulletItem Text="When a newer version is found, an Update button appears beside Close in the button column."/>

                <TextBlock Text="Privacy, licence and support" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <local:BulletItem Text="Everything stays in your task file on this PC. No account, no cloud, no tracking."/>
                <local:BulletItem Text="The Privacy Note and Licence Agreement are in About."/>
                <local:BulletItem Text="One licence covers one person, on any PCs they use."/>
                <local:BulletItem Text="For support, email support@hillierconsulting.ca, or click Report a Problem."/>
                <local:BulletItem Text="For general questions, email info@hillierconsulting.ca."/>

            </StackPanel>
        </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WhatsNewTab" Header="What's New">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8">
                    <!-- Filled in code from the changelog embedded in the exe (ReleaseNotes). -->
                    <StackPanel x:Name="WhatsNewPanel" MaxWidth="780" HorizontalAlignment="Left"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="_Report a Problem" Width="130" Padding="0,6" Margin="0,0,8,0" Click="ReportProblem_Click"
                    ToolTip="Open an email to support with the app's error log attached"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="_About" Width="90" Padding="0,6" Click="About_Click"
                    ToolTip="Version, ownership, and where this installation keeps its files"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <Button Content="Close" Width="90" Padding="0,6" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Close this window. (Esc)"/>
        </Grid>
    </Grid>
</Window>
