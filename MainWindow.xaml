<Window x:Class="KanbanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KanbanApp"
        xmlns:conv="clr-namespace:KanbanApp.Converters"
        mc:Ignorable="d"
        Title="Kanban" Height="740" Width="1700" MinWidth="900" MinHeight="500"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentPanelBrush" Color="#FF1E3A5F"/>
        <SolidColorBrush x:Key="AccentPanelBorderBrush" Color="#FF3E6491"/>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Margin="0,0,0,10" CornerRadius="6"
                Background="{StaticResource AccentPanelBrush}" BorderBrush="{StaticResource AccentPanelBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="KANBAN TASK BOARD" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CopyrightText}" FontSize="10" Foreground="#FFC0CBDA" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="{Binding SidebarDock}" Width="250" Margin="6" Padding="12"
                    CornerRadius="6"
                    Background="{StaticResource AccentPanelBrush}"
                    BorderBrush="{StaticResource AccentPanelBorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Sort &amp; Add" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="SortByProject_Click">
                                <TextBlock Text="Sort by Project" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="SortByDueDate_Click">
                                <TextBlock Text="Sort by Due Date" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="AddTask_Click">
                                <TextBlock Text="+ Add Task" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </WrapPanel>

                        <Separator Margin="0,12,0,0"/>

                        <TextBlock Text="Filter" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Project Filter" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProjectFilterOptions}" SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}"
                                  Padding="6" Margin="0,0,0,12"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Priority Filter" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PriorityFilterOptions}" SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}"
                                  Padding="6" Margin="0,0,0,12"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Who Filter" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding WhoFilterOptions}" SelectedItem="{Binding SelectedWhoFilter, Mode=TwoWay}"
                                  Padding="6" Margin="0,0,0,12"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Goal Filter" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding GoalFilterOptions}" SelectedItem="{Binding SelectedGoalFilter, Mode=TwoWay}"
                                  Padding="6" Margin="0,0,0,16"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Show Due" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <Border BorderBrush="{StaticResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,16">
                            <StackPanel>
                                <RadioButton x:Name="DueTodayRadio" Content="Today" GroupName="DueFilter" Tag="Today"
                                             Foreground="White" Margin="0,0,0,8" Checked="DueFilter_Checked"/>
                                <RadioButton x:Name="DueTomorrowRadio" Content="Tomorrow" GroupName="DueFilter" Tag="Tomorrow"
                                             Foreground="White" Margin="0,0,0,8" Checked="DueFilter_Checked"/>
                                <RadioButton x:Name="DueWithinWeekRadio" Content="Within a Week" GroupName="DueFilter" Tag="Within a Week"
                                             Foreground="White" Margin="0,0,0,8" Checked="DueFilter_Checked"/>
                                <RadioButton x:Name="DueNoDateRadio" Content="No Due Date" GroupName="DueFilter" Tag="No Due Date"
                                             Foreground="White" Checked="DueFilter_Checked"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Keyword Search" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding KeywordFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,16"
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <Button Content="Clear Filters" Padding="0,10" HorizontalAlignment="Stretch"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="ClearFilters_Click"/>

                        <Separator Margin="0,12,0,0"/>

                        <TextBlock Text="Other" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="ManageProjects_Click">
                                <TextBlock Text="Manage Projects" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="ManageGoals_Click">
                                <TextBlock Text="Manage Goals" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="ArchiveDone_Click">
                                <TextBlock Text="Archive Done" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="ViewArchived_Click">
                                <TextBlock Text="View Archived" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="ToggleTheme_Click">
                                <TextBlock Text="{Binding ThemeButtonLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="Settings_Click">
                                <TextBlock Text="Settings" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SquareButtonStyle}" Click="Close_Click">
                                <TextBlock Text="Close" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="{DynamicResource BoardAreaBrush}">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260" Margin="0,0,12,0" Padding="10" Background="{Binding Background}"
                                    CornerRadius="6" VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    AllowDrop="True" Drop="Column_Drop">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#FF1A1A1A"/>

                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                                        MouseMove="Card_MouseMove">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Background="#FFEFEFEF" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding ProjectName}" FontSize="10" Foreground="#FF666666"/>
                                                            </Border>
                                                            <Border Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                                                    CornerRadius="3" Padding="5,1" Margin="4,0,0,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding GoalDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,3,0,0"
                                                                   Visibility="{Binding GoalDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                                        <TextBlock Text="{Binding DueDateDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"
                                                                   Visibility="{Binding DueDateDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding WhoDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"
                                                                   Visibility="{Binding WhoDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding RecurrenceDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"
                                                                   Visibility="{Binding RecurrenceDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding LastUpdatedDisplay}" FontSize="9" FontStyle="Italic"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="E" Background="#FF607D8B"
                                                                    ToolTip="Edit" Click="EditQuickAction_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="T" Background="#FF42A5F5"
                                                                    Tag="To Do" ToolTip="Move to To Do" Click="QuickMove_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="P" Background="#FF26A69A"
                                                                    Tag="In Progress" ToolTip="Move to In Progress" Click="QuickMove_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="H" Background="#FFFFA726"
                                                                    Tag="On Hold" ToolTip="Move to On Hold" Click="QuickMove_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="W" Background="#FF9575CD"
                                                                    Tag="Waiting" ToolTip="Move to Waiting" Click="QuickMove_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="&#x2713;" Background="#FF66BB6A"
                                                                    Tag="Done" ToolTip="Mark Done" Click="QuickMove_Click"/>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="X" Background="#FFEF5350" Margin="0"
                                                                    ToolTip="Delete"
                                                                    Command="{Binding DataContext.DeleteCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
