<Window x:Class="KanbanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KanbanApp"
        xmlns:conv="clr-namespace:KanbanApp.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Width="1700" Height="900" MinWidth="900" MinHeight="600"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <conv:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentPanelBrush" Color="#FF1E3A5F"/>
        <SolidColorBrush x:Key="AccentPanelBorderBrush" Color="#FF3E6491"/>

        <!-- Explicit no-op style (no Template setter) so this stays square like the rest of the
             Filter cluster, instead of picking up the app-wide rounded Button style. -->
        <Style x:Key="ClearFiltersButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Own template (not just Padding) because the app-wide Button template hardcodes a
                 6px CornerRadius sized for full-size buttons — proportionally too large at 22x20px. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallSquareButtonStyle" BasedOn="{StaticResource SquareButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="SortButtonProject" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortButtonDueDate" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueDateSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortButtonWho" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WhoSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortButtonPriority" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PrioritySortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DueFilterButtonToday" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Today}" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DueFilterButtonTomorrow" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Tomorrow}" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DueFilterButtonWithinWeek" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Within a Week'}" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DueFilterButtonNone" BasedOn="{StaticResource SmallSquareButtonStyle}" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter='No Due Date'}" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="StatChipStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#FFC0CBDA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,6" Margin="0,0,0,10" CornerRadius="6" Cursor="Hand"
                ToolTip="Double-click for the Dashboard"
                Background="{StaticResource AccentPanelBrush}" BorderBrush="{StaticResource AccentPanelBorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource StatChipStyle}">
                        <TextBlock Text="{Binding OpenTaskCount}" Style="{StaticResource StatNumberStyle}" Foreground="White"/>
                        <TextBlock Text="Open" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatChipStyle}">
                        <TextBlock Text="{Binding OverdueCount}" Style="{StaticResource StatNumberStyle}" Foreground="#FFEF5350"/>
                        <TextBlock Text="Overdue" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatChipStyle}">
                        <TextBlock Text="{Binding DueTodayCount}" Style="{StaticResource StatNumberStyle}" Foreground="#FFFFA726"/>
                        <TextBlock Text="Due Today" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource StatChipStyle}">
                        <TextBlock Text="{Binding DueThisWeekCount}" Style="{StaticResource StatNumberStyle}" Foreground="#FFFFEE58"/>
                        <TextBlock Text="Due This Week" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="KANBAN TASK BOARD" FontSize="36" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="TEST BUILD" FontSize="11" FontWeight="Bold" Foreground="#FFFFEB3B" Background="#FFB71C1C"
                               Padding="6,1" HorizontalAlignment="Right"
                               Visibility="{Binding IsTestChannel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="{Binding SidebarDock}" Width="280" Margin="6" Padding="12"
                    CornerRadius="6"
                    Background="{StaticResource AccentPanelBrush}"
                    BorderBrush="{StaticResource AccentPanelBorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Sort &amp; Add" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SortButtonProject}" Background="#FF42A5F5" Foreground="White" Click="SortByProject_Click"
                                        ToolTip="Click to sort by project alone. Ctrl+click to add or remove project as a sort key alongside others.">
                                    <Grid>
                                        <TextBlock Text="Sort by Project" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Border Background="White" CornerRadius="7" Width="14" Height="14" Margin="0,-4,-4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding ProjectSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ProjectSortRank}" FontSize="9" FontWeight="Bold" Foreground="#FF1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SortButtonDueDate}" Background="#FF26A69A" Foreground="White" Click="SortByDueDate_Click"
                                        ToolTip="Click to sort by due date alone. Ctrl+click to add or remove due date as a sort key alongside others.">
                                    <Grid>
                                        <TextBlock Text="Sort by Due Date" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Border Background="White" CornerRadius="7" Width="14" Height="14" Margin="0,-4,-4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding DueDateSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DueDateSortRank}" FontSize="9" FontWeight="Bold" Foreground="#FF1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SortButtonWho}" Background="#FF7E57C2" Foreground="White" Click="SortByWho_Click"
                                        ToolTip="Click to sort by assignee alone. Ctrl+click to add or remove assignee as a sort key alongside others.">
                                    <Grid>
                                        <TextBlock Text="Sort by Who" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Border Background="White" CornerRadius="7" Width="14" Height="14" Margin="0,-4,-4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding WhoSortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                            <TextBlock Text="{Binding WhoSortRank}" FontSize="9" FontWeight="Bold" Foreground="#FF1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SortButtonPriority}" Background="#FFEF5350" Foreground="White" Click="SortByPriority_Click"
                                        ToolTip="Click to sort by priority alone. Ctrl+click to add or remove priority as a sort key alongside others.">
                                    <Grid>
                                        <TextBlock Text="Sort by Priority" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Border Background="White" CornerRadius="7" Width="14" Height="14" Margin="0,-4,-4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding PrioritySortRank, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                            <TextBlock Text="{Binding PrioritySortRank}" FontSize="9" FontWeight="Bold" Foreground="#FF1A1A1A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Style="{StaticResource SmallSquareButtonStyle}" Background="#FF66BB6A" Foreground="White" Click="AddTask_Click"
                                        ToolTip="Create a new task (Ctrl+N)">
                                    <TextBlock Text="New Task" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SmallSquareButtonStyle}" Background="#FF607D8B" Foreground="White" Click="ToggleCardSize_Click"
                                        ToolTip="Toggle task cards between large (full detail) and small (compact) display">
                                    <TextBlock Text="{Binding CardSizeButtonLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,12,0,0"/>

                        <TextBlock Text="Filter" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4"/>

                        <TextBlock Text="Project" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding ProjectFilterOptions}" SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}"
                                  Padding="4" Margin="0,0,0,6" ToolTip="Show only cards belonging to this project"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Priority" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding PriorityFilterOptions}" SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}"
                                  Padding="4" Margin="0,0,0,6" ToolTip="Show only cards with this priority"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Who" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding WhoFilterOptions}" SelectedItem="{Binding SelectedWhoFilter, Mode=TwoWay}"
                                  Padding="4" Margin="0,0,0,6" ToolTip="Show only cards assigned to this person"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Goal" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding GoalFilterOptions}" SelectedItem="{Binding SelectedGoalFilter, Mode=TwoWay}"
                                  Padding="4" Margin="0,0,0,6" ToolTip="Show only cards linked to this goal"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Flag" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding FlagFilterOptions}" SelectedItem="{Binding SelectedFlagFilter, Mode=TwoWay}"
                                  Padding="4" Margin="0,0,0,6" ToolTip="Show only cards carrying this flag"
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>

                        <TextBlock Text="Due" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Button Style="{StaticResource DueFilterButtonToday}" Background="#FF42A5F5" Foreground="White" Click="DueToday_Click"
                                    ToolTip="Show only cards due today or earlier (overdue)">
                                <TextBlock Text="Today" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource DueFilterButtonTomorrow}" Background="#FF26A69A" Foreground="White" Click="DueTomorrow_Click"
                                    ToolTip="Show only cards due tomorrow">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock Text="Tomorrow" TextAlignment="Center"/>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource DueFilterButtonWithinWeek}" Background="#FF7E57C2" Foreground="White" Click="DueWithinWeek_Click"
                                    ToolTip="Show only cards due within a week">
                                <TextBlock Text="Within a Week" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource DueFilterButtonNone}" Background="#FF607D8B" Foreground="White" Click="DueNone_Click"
                                    ToolTip="Show only cards with no due date">
                                <TextBlock Text="No Due Date" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="From" FontSize="10" Foreground="White" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding DueRangeFrom, Mode=TwoWay}" Padding="3"
                                            ToolTip="Leave blank to include everything up to 'To'"
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="To" FontSize="10" Foreground="White" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding DueRangeTo, Mode=TwoWay}" Padding="3"
                                            ToolTip="Leave blank to include everything from 'From' onward"
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Keyword" FontWeight="Bold" FontSize="11" Foreground="White" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding KeywordFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,8"
                                 ToolTip="Show only cards whose title, project, who, or notes contain this text"
                                 Style="{StaticResource HoverTextBoxStyle}"
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <Button Style="{StaticResource ClearFiltersButtonStyle}" Content="Clear Filters" HorizontalAlignment="Stretch"
                                ToolTip="Reset every filter back to All"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="ClearFilters_Click"/>

                        <Separator Margin="0,12,0,0"/>

                        <StackPanel Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF5C6BC0" Foreground="White" Click="ManageProjects_Click"
                                        ToolTip="Add, rename, or delete projects (Alt+P)">
                                    <TextBlock Text="Manage Projects" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF5C6BC0" Foreground="White" Click="ManageGoals_Click"
                                        ToolTip="Add, rename, or delete goals (Alt+G)">
                                    <TextBlock Text="Manage Goals" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF5C6BC0" Foreground="White" Click="ManageFlags_Click"
                                        ToolTip="Add, rename, or delete flags (Alt+F)">
                                    <TextBlock Text="Manage Flags" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF5C6BC0" Foreground="White" Click="ManageWho_Click"
                                        ToolTip="Add, rename, or delete people (Alt+W)">
                                    <TextBlock Text="Manage Who" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FFEF5350" Foreground="White" Click="Reminders_Click"
                                        ToolTip="Show tasks that are overdue or due today (Alt+R)">
                                    <TextBlock Text="Reminders" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF546E7A" Foreground="White" Click="ToggleTheme_Click"
                                        ToolTip="Switch between light and dark theme">
                                    <TextBlock Text="{Binding ThemeButtonLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FFFFA726" Foreground="White" Click="ArchiveDone_Click"
                                        ToolTip="Archive every task currently in the Done column (Alt+A)">
                                    <TextBlock Text="Archive Done" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FFFFA726" Foreground="White"
                                        ToolTip="Click: View Archived. Double-click: View Deleted."
                                        PreviewMouseLeftButtonDown="ViewArchived_PreviewMouseDown">
                                    <TextBlock Text="View Archived" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FFFFA726" Foreground="White"
                                        ToolTip="Click: Import Tasks from Excel. Double-click: Review Imported Tasks."
                                        PreviewMouseLeftButtonDown="ImportTasks_PreviewMouseDown">
                                    <TextBlock Text="Import Tasks" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF78909C" Foreground="White" Click="Settings_Click"
                                        ToolTip="Open app settings (Alt+S)">
                                    <TextBlock Text="Settings" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF26C6DA" Foreground="White" Click="Help_Click"
                                        ToolTip="Open the help screen">
                                    <TextBlock Text="Help" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SquareButtonStyle}" Background="#FF66BB6A" Foreground="White" Click="ReportBuilder_Click"
                                        ToolTip="Build a custom report and preview it or save it as a PDF (Ctrl+P)">
                                    <TextBlock Text="Report Builder" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,14,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SquareButtonStyle}" Background="#FFE57373" Foreground="White" Click="Close_Click"
                                    ToolTip="Close the application (Ctrl+Q)">
                                <TextBlock Text="Close" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="#FFC0CBDA"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding CopyrightText}" FontSize="9" Foreground="#FFC0CBDA"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="{DynamicResource BoardAreaBrush}">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding DataContext.ColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,12,0" Padding="10" Background="{Binding Background}"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                    AllowDrop="True" Drop="Column_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="{DynamicResource ColumnHeaderTextBrush}"
                                               Background="Transparent" Cursor="Hand" ToolTip="Double-click to add a new task in this column"
                                               MouseLeftButtonDown="ColumnHeader_MouseLeftButtonDown"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                                        MouseMove="Card_MouseMove"
                                                        AllowDrop="True" DragOver="Card_DragOver" Drop="Card_Drop">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardOutlineBrush}"/>
                                                            <!-- 2px at rest (not 1.5) so hover only swaps color - changing thickness on hover
                                                                 shifts every card below it in the column by a fraction of a pixel. -->
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Background" Value="#FFFFF176"/>
                                                                            <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ProjectName}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                                                       Cursor="Hand" ToolTip="Click to change project"
                                                                       MouseLeftButtonUp="ProjectName_MouseLeftButtonUp"/>
                                                            <Border Grid.Column="1" Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                                                    CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Cursor="Hand" ToolTip="Click to change priority"
                                                                    MouseLeftButtonUp="PriorityBadge_MouseLeftButtonUp">
                                                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="White"/>
                                                            </Border>
                                                        </Grid>

                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Visibility="{Binding DataContext.IsLargeCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding GoalDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,3,0,0"
                                                                               Visibility="{Binding GoalDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                                                    <TextBlock Text="{Binding FlagsDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontStyle="Italic" Margin="0,3,0,0"
                                                                               Visibility="{Binding FlagsDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding DueDateDisplay}" FontSize="10"
                                                                                   Cursor="Hand" ToolTip="Click to change due date"
                                                                                   MouseLeftButtonUp="DueDateDisplay_MouseLeftButtonUp"
                                                                                   Visibility="{Binding DueDateDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                            <Setter Property="Background" Value="#FFFFF176"/>
                                                                                            <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding WhoDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"
                                                                                   Cursor="Hand" ToolTip="Click to reassign"
                                                                                   MouseLeftButtonUp="WhoDisplay_MouseLeftButtonUp"
                                                                                   Visibility="{Binding WhoDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding RecurrenceDisplay}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"
                                                                               Visibility="{Binding RecurrenceDisplay, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding LastUpdatedDisplay}" FontSize="9" FontStyle="Italic"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>

                                                                    <TextBlock Text="{Binding AttachmentsCountDisplay}" FontSize="10"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"
                                                                               Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                                    <TextBlock Text="{Binding SubTaskProgressDisplay}" FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"
                                                                               Visibility="{Binding HasSubTasks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <ItemsControl ItemsSource="{Binding SubTasks}" Tag="{Binding}" Margin="0,2,0,0"
                                                                                  Visibility="{Binding HasSubTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsDone, Mode=OneWay}"
                                                                                          FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"
                                                                                          Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                                                                                          Checked="SubTaskCheckBox_Changed" Unchecked="SubTaskCheckBox_Changed"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding SubTaskProgressDisplay}" FontSize="9"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding HasSubTasks}" Value="True"/>
                                                                                        <Condition Binding="{Binding DataContext.IsLargeCards, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                                                                <Button Content="&#x1F3F7;" Background="#FF8D6E63"
                                                                        ToolTip="Add a flag" Click="AddFlagQuickAction_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.IsLargeCards, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="&#x2709;" Background="#FF1E88E5" Margin="0,4,0,0"
                                                                        ToolTip="Email this task to the assigned person" Click="EmailCardQuickAction_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding CanEmailCard}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <!-- Each quick-move button dims and disables itself when the card is already in
                                                                 that button's target column - clicking it there would be a no-op. The ancestor
                                                                 ItemsControl is this card's per-column Cards list, whose own DataContext is the
                                                                 enclosing ColumnViewModel, so its Name is the card's current column. -->
                                                            <Button Content="T" Background="#FF42A5F5"
                                                                    Tag="To Do" ToolTip="Move to To Do" Click="QuickMove_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="To Do">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="P" Background="#FFF9A825"
                                                                    Tag="In Progress" ToolTip="Move to In Progress" Click="QuickMove_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="In Progress">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="H" Background="#FFFB8C00"
                                                                    Tag="On Hold" ToolTip="Move to On Hold" Click="QuickMove_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="On Hold">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="W" Background="#FFAB47BC"
                                                                    Tag="Waiting" ToolTip="Move to Waiting" Click="QuickMove_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Waiting">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="&#x2713;" Background="#FF66BB6A"
                                                                    Tag="Done" ToolTip="Mark Done" Click="QuickMove_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource QuickActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Done">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Style="{StaticResource QuickActionButtonStyle}" Content="X" Background="#FFEF5350" Margin="0"
                                                                    ToolTip="Delete"
                                                                    Click="DeleteQuickAction_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
