<Window x:Class="KanbanApp.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Help" Height="640" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="HelpSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,16,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HelpBodyStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HelpBulletStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="12,2,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kanban Task Board — Help" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
            <StackPanel>
                <TextBlock Style="{StaticResource HelpBodyStyle}" TextWrapping="Wrap">
                    This board tracks tasks across five columns: To Do, In Progress, On Hold, Waiting, and Done.
                    Drag a card to a different column, or use its quick-move buttons.
                </TextBlock>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Ctrl+N — create a new task."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Ctrl+P — open Report Builder."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Ctrl+Q — quit the app."/>

                <TextBlock Text="Adding and editing tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Click New Task (Sort &amp; Add section) to create a task."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Double-click a column header (e.g. To Do, In Progress) to create a task already assigned to that column."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Double-click any card to open it for editing."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Each task can have a Category, Project, Goal, Priority, Due Date, Who it's assigned to, free-form Notes, Flags, and a checklist of Sub-tasks. Project is required; everything else is optional."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Use the + and − buttons next to Project, Goal, and Who to add a new one on the fly, or clear the current selection without deleting the record."/>

                <TextBlock Text="Sub-tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Add sub-task rows in the task dialog; each has its own checkbox."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Sub-task checkboxes also appear directly on the card (in large card view) so you can tick them off without opening the dialog."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• A done/total (percent) summary is shown both in the dialog and on the card."/>

                <TextBlock Text="Attachments" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• '+ File...' links an existing file to the task. The file stays where it is — the task just remembers the path, it isn't copied. If you later move, rename, or delete the original, the link breaks."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• 'Paste Screenshot' adds whatever image is on the clipboard (e.g. after PrtScn or the Snipping Tool). Unlike linked files, pasted screenshots are saved as real files in an 'Attachments' folder next to your database, so they travel with it if you relocate the database later."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Images show as a small thumbnail; other files show as a filename. Click either to open the file in its default app, or × to remove it from the task (removing a pasted screenshot also deletes its saved copy; removing a linked file never touches the original)."/>

                <TextBlock Text="Recurring tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Mark a task Recurring and choose a pattern (Daily, Weekday, Weekly, Bi-Weekly, Monthly, Bi-Monthly, Quarterly, or Annually)."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• When a recurring task is moved to Done, its next occurrence is created automatically in To Do with the same details and sub-task list — but with every sub-task unchecked."/>

                <TextBlock Text="Quick actions on a card" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The letter buttons move a card directly to To Do, In Progress, On Hold, or Waiting; the check mark moves it to Done; the X deletes it."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The tag icon, beside the task's details, adds an existing flag from a dropdown without opening the task."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Click a card's Priority badge, Assigned name, or due date to change any of them directly from the board, without opening the task."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• A task's title and due date are highlighted yellow once it's past due (and still outside Done)."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• A card's Project name is shown prominently just below the title."/>

                <TextBlock Text="Organizing: Projects, Goals, Flags, Who" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Manage Projects / Manage Goals / Manage Flags / Manage Who let you add, rename, or permanently delete these from the whole board."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Flags are multi-select tags — a task can carry more than one."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Projects, Goals, Who, and Flags are always listed alphabetically, everywhere they appear."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Untick a Project's, Goal's, Flag's, or Who's Active checkbox to retire it: it disappears from filters and from selection on new or edited tasks, but any task already using it keeps showing its name and is unaffected."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Delete warns you first with the number of tasks currently using that Project, Goal, Flag, or Who, since deleting it removes it from those tasks and cannot be undone."/>

                <TextBlock Text="Sorting and filtering" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Sort by Project, Due Date, Who, or Priority reorders every column. Sort by Due Date sorts by due date then project; Sort by Priority sorts by priority then due date. The active sort is shown with a highlighted border."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The Filter section narrows the board by Project, Priority, Who, Goal, Flag, Due date range, or a keyword search across titles."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Who, Goal, and Flag each offer an 'Unassigned' filter option, showing only tasks with none set."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The Today / Tomorrow / Within a Week / No Due Date buttons filter by due date; Today also includes overdue tasks. The active one is shown with a highlighted border."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Clear Filters resets every filter back to All."/>

                <TextBlock Text="Archiving and deleting" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Archive Done moves every task currently in Done out of the board."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Deleting a task never erases it — it's kept out of sight instead."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Click View Archived to browse archived tasks; double-click the same button to browse deleted tasks."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Either list lets you select a task and reactivate it back to To Do; in the Archived list, double-clicking a task reactivates it immediately."/>

                <TextBlock Text="Importing tasks" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Click Import Tasks to download an Excel template or choose a filled-in .xlsx file to import. Only Task Details is required; Category, Priority, Project, Goal, Due Date, and Who are all optional."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Category and Priority must be chosen from the template's dropdown. Project, Goal, and Who show a dropdown of existing values but also accept a new one you type in."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Enter Due Date as MM/DD/YYYY (year optional, defaults to the current year); it's displayed as DD-MMM-YYYY."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Projects, Goals, and People mentioned in the file that don't already exist are created automatically."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Right after import you're shown an editable list of the imported tasks to quickly fix up Category, Task Details, Priority, Project, Goal, Due Date, or Who."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Double-click Import Tasks any time to review every task still flagged as imported. Uncheck Imported and Save to clear that flag once you're done reviewing a task."/>

                <TextBlock Text="Report Builder" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Click Report Builder to design a custom report: choose which columns to include, filter by Project, Priority, Who, Goal, Flag, or Due date, group the results, and choose whether to include Notes and Sub-tasks."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Preview opens a print-preview window with distinct pages, zoom, and a print button; each page after the first repeats a running header and shows a 'Page X of Y' footer. PDF saves it as a real PDF file."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• PDFs are saved to the Default Export Path set in Settings, with a timestamped filename; if no Default Export Path is set, you'll be asked where to save."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Rows alternate shading for readability; grouped reports use a distinct alternating colour from ungrouped ones."/>

                <TextBlock Text="Dashboard" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The banner always shows Open, Overdue, Due Today, and Due This Week counts across all non-Done tasks."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Double-click the banner to open the full Dashboard: summary tiles, plus Status Distribution, Priority Mix, Due Date Timeline, By Project, and By Who charts."/>

                <TextBlock Text="Display options" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Dark Mode / Light Mode switches the whole app's theme."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Large Cards / Compact Cards toggles how much detail each card shows, useful for fitting more on screen at once."/>

                <TextBlock Text="Settings" Style="{StaticResource HelpSectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Move the button panel to the right side of the board."/>
        <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Set the task column width in pixels (default 310)."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Turn the startup splash screen on or off and set how long it stays visible."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Start the app in full screen."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The window size and position are remembered automatically between sessions; the full-screen setting still applies on top of that when starting up."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Require a yes/no confirmation before deleting a task, project, goal, or flag — turn this off to delete immediately without asking."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Require a yes/no confirmation before Archive Done — turn this off to archive immediately without asking."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Ask whether to add a note whenever a task is moved to Done; answering yes opens the task with the cursor already in the Notes field."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Change where the task database file is stored. The old file is automatically removed once the app has restarted at the new location."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• The chosen location itself is remembered outside the database, in a small config file under your local AppData folder — not inside the database file."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Set a Default Export Path (used by Report Builder's PDF export) and a Default Import Path (used by Import Tasks, including where the template is saved)."/>
                <TextBlock Style="{StaticResource HelpBulletStyle}" Text="• Set a Linked Files Default Path for future use, once file linking support is added."/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="90" Padding="0,6"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
    </Grid>
</Window>
