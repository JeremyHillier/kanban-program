<Window x:Class="KanbanApp.Views.ImportedTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:KanbanApp.ViewModels"
        mc:Ignorable="d"
        Title="Imported Tasks" Height="620" Width="1180" MinWidth="900" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="CellMargin" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="4,3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16" IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Imported Tasks" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Text="Uncheck Imported and Save to remove a task from this review list."
                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <!-- Header row -->
        <Grid Grid.Row="1" Margin="0,10,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" SharedSizeGroup="Title"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Category"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Priority"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Project"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Goal"/>
                <ColumnDefinition Width="*" SharedSizeGroup="DueDate"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Who"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Imported"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Task Details" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="Category" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="Project" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="Goal" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="5" Text="Due Date" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="6" Text="Who" Style="{StaticResource ColHeaderStyle}"/>
            <TextBlock Grid.Column="7" Text="Imported" Style="{StaticResource ColHeaderStyle}"/>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImportedRowEditViewModel}">
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" SharedSizeGroup="Title"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="Category"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="Priority"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="Project"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="Goal"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="DueDate"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="Who"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Imported"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource CellMargin}" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="1" Style="{StaticResource CellMargin}" Padding="4"
                                              ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding ColumnId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="2" Style="{StaticResource CellMargin}" Padding="4"
                                              ItemsSource="{x:Static vm:PriorityOptions.All}" SelectedItem="{Binding Priority, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="3" Style="{StaticResource CellMargin}" Padding="4"
                                              ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding ProjectId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <ComboBox Grid.Column="4" Style="{StaticResource CellMargin}" Padding="4"
                                              ItemsSource="{Binding DataContext.Goals, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding GoalId, Mode=TwoWay}"
                                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <DatePicker Grid.Column="5" Style="{StaticResource CellMargin}" Padding="4"
                                                SelectedDate="{Binding DueDate, Mode=TwoWay}"
                                                Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <TextBox Grid.Column="6" Style="{StaticResource CellMargin}" Text="{Binding Who, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"/>

                                    <CheckBox Grid.Column="7" Style="{StaticResource CellMargin}" IsChecked="{Binding IsImported, Mode=TwoWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="EmptyStateText" Grid.Row="2" Text="No imported tasks to review."
                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Width="90" Padding="0,6" IsCancel="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Save Changes" Width="120" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="SaveChanges_Click"
                    Background="#FF66BB6A" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
