<Window x:Class="KanbanApp.Views.ArchivedTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Archived Tasks" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Archived from" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
            <DatePicker x:Name="FromDatePicker" Width="120" SelectedDateChanged="DateRange_Changed"/>
            <TextBlock Text="to" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,6,0"/>
            <DatePicker x:Name="ToDatePicker" Width="120" SelectedDateChanged="DateRange_Changed"/>
        </StackPanel>

        <ListBox x:Name="ArchivedList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 AlternationCount="2"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="ArchivedList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4"
                            ToolTip="Right-click for more options"
                            MouseRightButtonDown="ArchivedItem_MouseRightButtonDown">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding ColumnName, Mode=OneWay}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                <Run Text=" • archived "/>
                                <Run Text="{Binding ArchivedAt, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="No archived tasks yet."
                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reactivate to To Do" Padding="10,6" Click="Reactivate_Click"
                    Background="#FF66BB6A" Foreground="White"/>
            <Button Content="Close" Width="90" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
