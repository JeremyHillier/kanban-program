<Window x:Class="KanbanApp.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="About Kanban Task Board" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="AboutSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,16,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <!-- Identity band. Deliberately fixed dark navy in both themes (matching the report
             header's accent) - the white text on it is sized for this background specifically. -->
        <Border Background="#FF1E3A5F" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="12" VerticalAlignment="Top"
                        Background="#FF16304F">
                    <Image Source="/Assets/app.ico" Width="52" Height="52" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Kanban Task Board" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="A visual task board for tracking work across projects, people, and goals."
                               FontSize="12" Foreground="#FFC0CBDA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="White" Margin="0,12,0,0"/>
                    <TextBlock x:Name="CompanyText" FontSize="12" Foreground="#FFC0CBDA" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CopyrightText" FontSize="12" Foreground="#FFC0CBDA" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="24,4,24,0">
            <TextBlock Text="What it does" Style="{StaticResource AboutSectionHeaderStyle}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="Tracks tasks across five columns, organised by project, goal, assignee, priority, flags, and due date. Supports sub-tasks, file and screenshot attachments, recurring tasks, and overdue reminders. Builds filtered PDF reports, charts progress on a dashboard, imports tasks from Excel, and keeps everything in a single SQLite file you choose the location of."/>

            <TextBlock Text="This installation" Style="{StaticResource AboutSectionHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" Style="{StaticResource DetailLabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ChannelText" Style="{StaticResource DetailValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Task database" Style="{StaticResource DetailLabelStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DbPathText" Style="{StaticResource DetailValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Settings file" Style="{StaticResource DetailLabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SettingsPathText" Style="{StaticResource DetailValueStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime" Style="{StaticResource DetailLabelStyle}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RuntimeText" Style="{StaticResource DetailValueStyle}"/>
            </Grid>

            <TextBlock Text="Acknowledgements" Style="{StaticResource AboutSectionHeaderStyle}"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="PDF rendering by PDFsharp. Excel import by ClosedXML. Data stored with SQLite via Microsoft.Data.Sqlite. Installer built with Inno Setup."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,20,24,20">
            <Button Content="Copy details" Width="110" Padding="0,6" Margin="0,0,8,0" Click="CopyDetails_Click"
                    ToolTip="Copy the version and installation details to the clipboard"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Website" Width="90" Padding="0,6" Margin="0,0,8,0" Click="Website_Click"
                    ToolTip="Open hillierconsulting.ca in your browser"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Close" Width="90" Padding="0,6" IsCancel="True" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </StackPanel>
</Window>
