<Window x:Class="KanbanApp.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KanbanApp.Views"
        Title="Update Available" Width="620" SizeToContent="Height" MinHeight="260" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadlineText" FontWeight="Bold" FontSize="18"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="SubheadText" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
        </StackPanel>

        <!-- Same layout as the What's New screen: the version as a heading, its notes as bullets. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"
                           Foreground="{DynamicResource AccentTextBrush}"/>
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:BulletItem Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoNotesText" Visibility="Collapsed" TextWrapping="Wrap"
                           Text="See the download page for what is new in this version."
                           Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextStrongBrush}"
                   Text="Get the Update opens our download page in your browser. Run the installer from there; it updates the program in place and leaves your tasks as they are."/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="SkipButton" Content="Skip This Version" Width="140" Padding="0,6" HorizontalAlignment="Left" Click="Skip_Click"
                    ToolTip="Don't tell me about this version again. The next one will still be offered."
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Remind Me Later" Width="130" Padding="0,6" Margin="0,0,8,0" IsCancel="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Get the Update" Width="130" Padding="0,6" IsDefault="True" Click="GetUpdate_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
