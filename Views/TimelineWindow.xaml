<Window x:Class="KanbanApp.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Timeline" Height="700" Width="1100" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Timeline" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="PrevButton" Padding="10,6" Click="Prev_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Today" Padding="10,6" Margin="6,0,0,0" Click="Today_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="NextButton" Padding="10,6" Margin="6,0,0,0" Click="Next_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="RangeLabel" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                <RadioButton x:Name="WeekViewRadio" Content="Week view" GroupName="ZoomLevel" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                             Checked="ZoomLevel_Changed" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <RadioButton x:Name="DayViewRadio" Content="Day view" GroupName="ZoomLevel" VerticalAlignment="Center"
                             Checked="ZoomLevel_Changed" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <CheckBox x:Name="IncludeDoneCheckBox" Content="Include Done tasks" VerticalAlignment="Center"
                      Margin="24,0,0,0" Checked="IncludeDoneCheckBox_Changed" Unchecked="IncludeDoneCheckBox_Changed"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Frozen date-header row: its own ScrollViewer with no visible scrollbars, driven
                 programmatically to track the body's horizontal offset (see BodyScrollViewer_ScrollChanged)
                 so the header columns stay lined up with the body's while only the body scrolls vertically. -->
            <ScrollViewer x:Name="HeaderScrollViewer" Grid.Row="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="HeaderGrid"/>
            </ScrollViewer>

            <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="BodyScrollViewer_ScrollChanged">
                <Grid x:Name="TimelineGrid"/>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Print" Width="90" Padding="0,6" Click="Print_Click"
                    Background="#FF66BB6A" Foreground="White"/>
            <Button Content="Close" Width="90" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" IsDefault="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
