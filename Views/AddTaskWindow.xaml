<Window x:Class="KanbanApp.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Add Task" Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldLabelRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="NewLinkButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Add new"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style x:Key="DeleteLinkButtonStyle" BasedOn="{StaticResource NewLinkButtonStyle}" TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="ToolTip" Value="Clear selection"/>
        </Style>
    </Window.Resources>
    <Grid Margin="0,16,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MaxHeight is set explicitly in code-behind (not left to the Window's own MaxHeight +
             SizeToContent to sort out) - a Grid row's Auto/Star sizing doesn't reliably constrain a
             child's measure pass under SizeToContent="Height", so without a MaxHeight set directly
             here the ScrollViewer never activates its own scrollbar and a long sub-task list just
             grows the window straight past the screen's bottom edge, taking the Cancel/Add Task
             buttons with it. -->
        <ScrollViewer Grid.Row="0" x:Name="FormScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,0">
                <!-- New tasks only: start from a saved template. Choosing one fills in the fields
                     below; everything can still be changed before saving. -->
                <Border x:Name="TemplatePanel" Margin="0,0,0,12" Padding="8,6" CornerRadius="4"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Template" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ComboBox Grid.Column="1" x:Name="TemplateComboBox" Padding="6" DisplayMemberPath="Name"
                                  SelectionChanged="TemplateComboBox_SelectionChanged"
                                  ToolTip="Start this task from a saved template. To make one, fill in a task and click Save as Template, or right-click a task on the board."
                                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <Button Grid.Column="2" Content="Manage..." Padding="10,4" Margin="6,0,0,0" Click="ManageTemplates_Click" IsTabStop="False"
                                ToolTip="Rename or delete templates"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Project -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}" Margin="0,0,0,4">
                    <TextBlock Text="Project *" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" ToolTip="Required"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new project" Click="NewProject_Click"/>
                    <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear project" Click="DeleteProject_Click"/>
                </StackPanel>
                <ComboBox x:Name="ProjectComboBox" Padding="6"
                          DisplayMemberPath="Name" SelectedIndex="0"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource CardBorderBrush}"/>

                <!-- Task details -->
                <TextBlock Text="Task" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="DetailsTextBox" Height="54" Padding="6" MaxLength="255"
                          TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                          SpellCheck.IsEnabled="True" Language="en-CA"
                          Style="{StaticResource HoverTextBoxStyle}"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- Compact three-column fields -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Priority | Category | Who -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="4" Style="{StaticResource FieldLabelRowStyle}">
                        <TextBlock Text="Who" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new person" Click="NewWho_Click"/>
                        <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear who" Click="DeleteWho_Click"/>
                    </StackPanel>
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="PriorityComboBox" Padding="6" SelectedIndex="2"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Low"/>
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CategoryComboBox" Padding="6"
                              DisplayMemberPath="DisplayName" SelectedIndex="0"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <ComboBox Grid.Row="1" Grid.Column="4" x:Name="WhoComboBox" Padding="6" SelectedIndex="-1"
                              DisplayMemberPath="Name" SelectionChanged="WhoComboBox_SelectionChanged"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                    <!-- Dates box (Start, Due / Recurring, Time) | Goal, Force edit -->
                    <!-- Everything about when: the dates on the first line, how it repeats and its
                         alert time on the second. Boxed so it reads as one group. -->
                    <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="10,8"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Start -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           ToolTip="Optional. The earliest date this task can be worked on."/>
                                <DatePicker Grid.Column="1" x:Name="StartDatePicker" Padding="4"
                                            ToolTip="Optional. The earliest date this task can be worked on. Hide Future on the main screen keeps the task off the board until then."
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                                <Button Grid.Column="2" Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearStartDate_Click" IsTabStop="False"
                                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>

                            <!-- Due -->
                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Due" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <DatePicker Grid.Column="1" x:Name="DueDatePicker" Padding="4"
                                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                                <Button Grid.Column="2" Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayDueDate_Click"
                                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Button Grid.Column="3" Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueDate_Click"
                                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>

                            <!-- Recurring -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="RecurringCheckBox" Content="Recurring task" VerticalAlignment="Center"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          Checked="RecurringCheckBox_Changed" Unchecked="RecurringCheckBox_Changed"/>
                                <ComboBox x:Name="RecurrenceComboBox" Padding="8,4" MinWidth="110" SelectedIndex="0" Visibility="Collapsed"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource CardBorderBrush}">
                                    <ComboBoxItem Content="Daily"/>
                                    <ComboBoxItem Content="Weekday"/>
                                    <ComboBoxItem Content="Weekly"/>
                                    <ComboBoxItem Content="Bi-Weekly"/>
                                    <ComboBoxItem Content="Semi-Monthly" ToolTip="Twice a month, on two fixed days taken from the due date - a task due on the 3rd repeats on the 3rd and the 18th. Due dates from the 13th on pair the 15th with the last day of the month."/>
                                    <ComboBoxItem Content="Monthly"/>
                                    <ComboBoxItem Content="Bi-Monthly"/>
                                    <ComboBoxItem Content="Quarterly"/>
                                    <ComboBoxItem Content="Annually"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Alert time -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Time" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid Width="100">
                                    <TextBox x:Name="DueTimeTextBox" Padding="6" LostFocus="DueTimeTextBox_LostFocus" TextChanged="DueTimeTextBox_TextChanged"
                                             Style="{StaticResource HoverTextBoxStyle}"
                                             ToolTip="Optional time on the due date, e.g. 2:30 PM or 14:30. Use AM / PM to pick the half of the day. While the app is running, you'll get an alert when that time arrives."
                                             Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="e.g. 2:30 PM" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DueTimeTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="AmButton" Content="AM" Width="38" Margin="6,0,0,0" Click="Meridiem_Click" IsTabStop="False"
                                        ToolTip="Morning - a time typed without AM or PM is read as AM"
                                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Button x:Name="PmButton" Content="PM" Width="38" Margin="4,0,0,0" Click="Meridiem_Click" IsTabStop="False"
                                        ToolTip="Afternoon / evening - a time typed without AM or PM is read as PM"
                                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldLabelRowStyle}">
                        <TextBlock Text="Goal" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new goal" Click="NewGoal_Click"/>
                        <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear goal" Click="DeleteGoal_Click"/>
                    </StackPanel>
                    <ComboBox Grid.Row="3" Grid.Column="4" x:Name="GoalComboBox" Padding="6" SelectedIndex="-1"
                              DisplayMemberPath="Name" VerticalAlignment="Top"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <CheckBox Grid.Row="4" Grid.Column="4" x:Name="ForceEditOnCompleteCheckBox" Content="Force edit upon completion" Margin="0,12,0,4"
                              Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"
                              ToolTip="When on, marking this task Done will automatically open it for editing instead of just moving it."/>
                </Grid>

                <!-- Website | Waiting On -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Website" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="WebsiteUrlTextBox" Padding="6"
                                 Style="{StaticResource HoverTextBoxStyle}"
                                 ToolTip="An optional web link or email address for this task - paste it, then click Open to launch it"
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Grid.Column="1" Content="Open" Padding="10,4" Margin="6,0,0,0" Click="OpenWebsite_Click"
                                ToolTip="Open this link in your default browser"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Waiting On" Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Who or what is holding this task up. Leave it empty if nothing is."/>
                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="WaitingOnTextBox" Padding="6" MaxLength="200"
                                 Style="{StaticResource HoverTextBoxStyle}"
                                 ToolTip="Who or what is holding this task up, e.g. Sam's quote, or the client's sign-off. Leave it empty if nothing is. The card shows it, and the Waiting On button on the main screen lists every task that has one. It is cleared when the task is finished."
                                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Grid.Column="1" Content="Clear" Padding="10,4" Margin="6,0,0,0" Click="ClearWaitingOn_Click" IsTabStop="False"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NotesTextBox" Height="110" Padding="6"
                          TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                          SpellCheck.IsEnabled="True" Language="en-CA"
                          Style="{StaticResource HoverTextBoxStyle}"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- Flags -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}">
                    <TextBlock Text="Flags" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new flag" Click="NewFlag_Click"/>
                </StackPanel>
                <WrapPanel x:Name="FlagsPanel" VerticalAlignment="Top"/>

                <!-- Sub-tasks -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}">
                    <TextBlock Text="Sub-tasks" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add sub-task" Click="AddSubTaskRow_Click"/>
                    <TextBlock x:Name="SubTaskProgressLabel" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Grid>
                    <StackPanel x:Name="SubTasksPanel" AllowDrop="True"
                                DragOver="SubTasksPanel_DragOver" DragLeave="SubTasksPanel_DragLeave" Drop="SubTasksPanel_Drop"/>
                    <Border x:Name="SubTaskInsertionIndicator" Height="2" Background="{DynamicResource AccentTextBrush}"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>

                <!-- Attachments -->
                <Border AllowDrop="True" DragOver="AttachmentsDropZone_DragOver" Drop="AttachmentsDropZone_Drop"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                        Margin="0,12,0,0" Padding="8,6">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FieldLabelRowStyle}" Margin="0,0,0,4">
                            <TextBlock Text="Attachments" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="+ File..." Padding="8,2" Margin="8,0,0,0" Click="AddFile_Click" ToolTip="Choose a file to copy into this task's Attachments folder"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Button Content="📷 Paste Screenshot" Padding="8,2" Margin="6,0,0,0" Click="PasteScreenshot_Click" ToolTip="Paste an image from the clipboard"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="or drag a file / an email from Outlook here" FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <StackPanel x:Name="AttachmentsPanel" MinHeight="8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16,10,16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="?" Width="32" Padding="0,6" Click="Help_Click" ToolTip="Help"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <!-- Edit mode only: when the task was finished (if it has been) and last changed. -->
                <StackPanel x:Name="TaskStampPanel" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CompletedStampText" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"
                               Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
                    <TextBlock x:Name="UpdatedStampText" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Save as Template..." Padding="12,6" Margin="0,0,8,0" Click="SaveAsTemplate_Click"
                        ToolTip="Save what is filled in here as a template for new tasks. Dates are kept as so many days from today; attachments and Waiting On are not kept."
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="EmailButton" Content="&#x2709; Email" Width="90" Padding="0,6" Margin="0,0,8,0" Click="Email_Click"
                        Visibility="Collapsed" ToolTip="Email this task to the assigned person"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Cancel" Width="80" Padding="0,6" IsCancel="True"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button x:Name="SubmitButton" Content="Add Task" Width="90" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="Add_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
