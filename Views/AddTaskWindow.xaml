<Window x:Class="KanbanApp.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Add Task" Height="460" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="NewLinkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,6,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Add new"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Task details" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DetailsTextBox" Height="60" Padding="6"
                  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <!-- Row: Category / Priority -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="3" Grid.Column="0" x:Name="CategoryComboBox" Padding="6"
                  DisplayMemberPath="Name" SelectedIndex="0"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <ComboBox Grid.Row="3" Grid.Column="2" x:Name="PriorityComboBox" Padding="6" SelectedIndex="2"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}">
            <ComboBoxItem Content="High"/>
            <ComboBoxItem Content="Medium"/>
            <ComboBoxItem Content="Normal"/>
        </ComboBox>

        <!-- Row: Project / Due Date -->
        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="Project" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new project" Click="NewProject_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="Due Date" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="5" Grid.Column="0" x:Name="ProjectComboBox" Padding="6"
                  DisplayMemberPath="Name" SelectedIndex="0"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <Grid Grid.Row="5" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0" x:Name="DueDatePicker" Padding="4"
                        Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Grid.Column="1" Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueDate_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Grid>

        <!-- Row: Goal / Who -->
        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="Goal" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new goal" Click="NewGoal_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="6" Grid.Column="2" Text="Who" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="7" Grid.Column="0" x:Name="GoalComboBox" Padding="6" SelectedIndex="-1" VerticalAlignment="Top"
                  DisplayMemberPath="Name"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <StackPanel Grid.Row="7" Grid.Column="2" VerticalAlignment="Top">
            <TextBox x:Name="WhoTextBox" Padding="6"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>

            <CheckBox x:Name="RecurringCheckBox" Content="Recurring task" Margin="0,14,0,4"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Checked="RecurringCheckBox_Changed" Unchecked="RecurringCheckBox_Changed"/>
            <ComboBox x:Name="RecurrenceComboBox" Padding="6" SelectedIndex="0" Visibility="Collapsed"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}">
                <ComboBoxItem Content="Daily"/>
                <ComboBoxItem Content="Weekday"/>
                <ComboBoxItem Content="Weekly"/>
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="Annually"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,14,0,4" VerticalAlignment="Bottom">
            <TextBlock Text="Flags" Style="{StaticResource FieldLabelStyle}" Margin="0" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new flag" Click="NewFlag_Click"/>
        </StackPanel>
        <WrapPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" x:Name="FlagsPanel" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Padding="0,6" IsCancel="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="SubmitButton" Content="Add Task" Width="90" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="Add_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
