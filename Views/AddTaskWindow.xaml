<Window x:Class="KanbanApp.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Add Task" Height="460" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldLabelRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="NewLinkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Add new"/>
        </Style>
        <Style x:Key="DeleteLinkButtonStyle" BasedOn="{StaticResource NewLinkButtonStyle}" TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="ToolTip" Value="Clear selection"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Task details" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="DetailsTextBox" Height="54" Padding="6"
                  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <!-- Row: Category / Priority -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" Style="{StaticResource FieldLabelStyle}"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="3" Grid.Column="0" x:Name="CategoryComboBox" Padding="6"
                  DisplayMemberPath="Name" SelectedIndex="0"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <ComboBox Grid.Row="3" Grid.Column="2" x:Name="PriorityComboBox" Padding="6" SelectedIndex="2"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}">
            <ComboBoxItem Content="High"/>
            <ComboBoxItem Content="Medium"/>
            <ComboBoxItem Content="Normal"/>
        </ComboBox>

        <!-- Row: Project / Due Date -->
        <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Project" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new project" Click="NewProject_Click"/>
            <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear project" Click="DeleteProject_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="Due Date" Style="{StaticResource FieldLabelStyle}"/>
        <ComboBox Grid.Row="5" Grid.Column="0" x:Name="ProjectComboBox" Padding="6" VerticalAlignment="Top"
                  DisplayMemberPath="Name" SelectedIndex="0"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <StackPanel Grid.Row="5" Grid.Column="2" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" x:Name="DueDatePicker" Padding="4"
                            Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"/>
                <Button Grid.Column="1" Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueDate_Click"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Grid>
            <CheckBox x:Name="RecurringCheckBox" Content="Recurring task" Margin="0,8,0,4"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Checked="RecurringCheckBox_Changed" Unchecked="RecurringCheckBox_Changed"/>
            <ComboBox x:Name="RecurrenceComboBox" Padding="6" SelectedIndex="0" Visibility="Collapsed"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}">
                <ComboBoxItem Content="Daily"/>
                <ComboBoxItem Content="Weekday"/>
                <ComboBoxItem Content="Weekly"/>
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="Annually"/>
            </ComboBox>
        </StackPanel>

        <!-- Row: Goal / Who -->
        <StackPanel Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Goal" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new goal" Click="NewGoal_Click"/>
            <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear goal" Click="DeleteGoal_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Grid.Column="2" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Who" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new person" Click="NewWho_Click"/>
            <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear who" Click="DeleteWho_Click"/>
        </StackPanel>
        <ComboBox Grid.Row="7" Grid.Column="0" x:Name="GoalComboBox" Padding="6" SelectedIndex="-1" VerticalAlignment="Top"
                  DisplayMemberPath="Name"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>
        <ComboBox Grid.Row="7" Grid.Column="2" x:Name="WhoComboBox" Padding="6" SelectedIndex="-1" VerticalAlignment="Top"
                  DisplayMemberPath="Name"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
        <TextBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" x:Name="NotesTextBox" Height="50" Padding="6"
                  TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Flags" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new flag" Click="NewFlag_Click"/>
        </StackPanel>
        <WrapPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" x:Name="FlagsPanel" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Sub-tasks" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add sub-task" Click="AddSubTaskRow_Click"/>
            <TextBlock x:Name="SubTaskProgressLabel" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" x:Name="SubTasksPanel"/>

        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldLabelRowStyle}">
            <TextBlock Text="Attachments" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Button Content="+ File..." Padding="8,2" Margin="8,0,0,0" Click="AddFile_Click" ToolTip="Link an existing file (the file itself is not copied)"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="📷 Paste Screenshot" Padding="8,2" Margin="6,0,0,0" Click="PasteScreenshot_Click" ToolTip="Paste an image from the clipboard"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" x:Name="AttachmentsPanel"/>

        <StackPanel Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Padding="0,6" IsCancel="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="SubmitButton" Content="Add Task" Width="90" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="Add_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
