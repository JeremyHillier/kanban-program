<Window x:Class="KanbanApp.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Add Task" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldLabelRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="NewLinkButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Add new"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style x:Key="DeleteLinkButtonStyle" BasedOn="{StaticResource NewLinkButtonStyle}" TargetType="Button">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="ToolTip" Value="Clear selection"/>
        </Style>
    </Window.Resources>
    <Grid Margin="0,16,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MaxHeight is set explicitly in code-behind (not left to the Window's own MaxHeight +
             SizeToContent to sort out) - a Grid row's Auto/Star sizing doesn't reliably constrain a
             child's measure pass under SizeToContent="Height", so without a MaxHeight set directly
             here the ScrollViewer never activates its own scrollbar and a long sub-task list just
             grows the window straight past the screen's bottom edge, taking the Cancel/Add Task
             buttons with it. -->
        <ScrollViewer Grid.Row="0" x:Name="FormScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,0">
                <!-- Project -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}" Margin="0,0,0,4">
                    <TextBlock Text="Project *" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" ToolTip="Required"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new project" Click="NewProject_Click"/>
                    <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear project" Click="DeleteProject_Click"/>
                </StackPanel>
                <ComboBox x:Name="ProjectComboBox" Padding="6"
                          DisplayMemberPath="Name" SelectedIndex="0"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                          BorderBrush="{DynamicResource CardBorderBrush}"/>

                <!-- Task details -->
                <TextBlock Text="Task details" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="DetailsTextBox" Height="54" Padding="6"
                          TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource HoverTextBoxStyle}"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- Compact two-column fields -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Priority | Category -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Priority" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="PriorityComboBox" Padding="6" SelectedIndex="2"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Low"/>
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CategoryComboBox" Padding="6"
                              DisplayMemberPath="DisplayName" SelectedIndex="0"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                    <!-- Due Date | Who -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Due Date" Style="{StaticResource FieldLabelStyle}"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelRowStyle}">
                        <TextBlock Text="Who" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new person" Click="NewWho_Click"/>
                        <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear who" Click="DeleteWho_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="3" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="DueDatePicker" Padding="4"
                                    Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"/>
                        <Button Grid.Column="1" Content="Today" Padding="8,4" Margin="6,0,0,0" Click="TodayDueDate_Click"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Grid.Column="2" Content="Clear" Padding="8,4" Margin="6,0,0,0" Click="ClearDueDate_Click"
                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                    <ComboBox Grid.Row="3" Grid.Column="2" x:Name="WhoComboBox" Padding="6" SelectedIndex="-1"
                              DisplayMemberPath="Name" SelectionChanged="WhoComboBox_SelectionChanged"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>

                    <!-- Goal | Recurring -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelRowStyle}">
                        <TextBlock Text="Goal" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new goal" Click="NewGoal_Click"/>
                        <Button Content="−" Style="{StaticResource DeleteLinkButtonStyle}" ToolTip="Clear goal" Click="DeleteGoal_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="4" Grid.Column="2" x:Name="RecurringCheckBox" Content="Recurring task"
                              VerticalAlignment="Bottom" Margin="0,12,0,4"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Checked="RecurringCheckBox_Changed" Unchecked="RecurringCheckBox_Changed"/>
                    <ComboBox Grid.Row="5" Grid.Column="0" x:Name="GoalComboBox" Padding="6" SelectedIndex="-1"
                              DisplayMemberPath="Name"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <ComboBox Grid.Row="5" Grid.Column="2" x:Name="RecurrenceComboBox" Padding="6" SelectedIndex="0" Visibility="Collapsed"
                              Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="Weekday"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="Bi-Weekly"/>
                        <ComboBoxItem Content="Monthly"/>
                        <ComboBoxItem Content="Bi-Monthly"/>
                        <ComboBoxItem Content="Quarterly"/>
                        <ComboBoxItem Content="Annually"/>
                    </ComboBox>

                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ForceEditOnCompleteCheckBox" Content="Force edit upon completion" Margin="0,12,0,4"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              ToolTip="When on, marking this task Done will automatically open it for editing instead of just moving it."/>
                </Grid>

                <!-- Notes -->
                <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NotesTextBox" Height="110" Padding="6"
                          TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource HoverTextBoxStyle}"
                          Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                <!-- Flags -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}">
                    <TextBlock Text="Flags" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add new flag" Click="NewFlag_Click"/>
                </StackPanel>
                <WrapPanel x:Name="FlagsPanel" VerticalAlignment="Top"/>

                <!-- Sub-tasks -->
                <StackPanel Style="{StaticResource FieldLabelRowStyle}">
                    <TextBlock Text="Sub-tasks" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource NewLinkButtonStyle}" ToolTip="Add sub-task" Click="AddSubTaskRow_Click"/>
                    <TextBlock x:Name="SubTaskProgressLabel" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <Grid>
                    <StackPanel x:Name="SubTasksPanel" AllowDrop="True"
                                DragOver="SubTasksPanel_DragOver" DragLeave="SubTasksPanel_DragLeave" Drop="SubTasksPanel_Drop"/>
                    <Border x:Name="SubTaskInsertionIndicator" Height="2" Background="{DynamicResource AccentTextBrush}"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>

                <!-- Attachments -->
                <Border AllowDrop="True" DragOver="AttachmentsDropZone_DragOver" Drop="AttachmentsDropZone_Drop"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                        Margin="0,12,0,0" Padding="8,6">
                    <StackPanel>
                        <StackPanel Style="{StaticResource FieldLabelRowStyle}" Margin="0,0,0,4">
                            <TextBlock Text="Attachments" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="+ File..." Padding="8,2" Margin="8,0,0,0" Click="AddFile_Click" ToolTip="Choose a file to copy into this task's Attachments folder"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Button Content="📷 Paste Screenshot" Padding="8,2" Margin="6,0,0,0" Click="PasteScreenshot_Click" ToolTip="Paste an image from the clipboard"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="or drag a file / an email from Outlook here" FontSize="10" FontStyle="Italic"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <StackPanel x:Name="AttachmentsPanel" MinHeight="8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="16,10,16,0">
            <Button x:Name="EmailButton" Content="&#x2709; Email" Width="90" Padding="0,6" Margin="0,0,8,0" Click="Email_Click"
                    Visibility="Collapsed" ToolTip="Email this task to the assigned person"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button Content="Cancel" Width="80" Padding="0,6" IsCancel="True"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="SubmitButton" Content="Add Task" Width="90" Padding="0,6" Margin="8,0,0,0" IsDefault="True" Click="Add_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Grid>
</Window>
