<Window x:Class="KanbanApp.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Add" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" AllowsTransparency="True" Background="Transparent">
    <!-- A bare, always-on-top strip: it appears over whatever program is in front, so it carries
         its own border rather than a title bar. Enter adds, Esc closes. -->
    <Border Margin="12" Padding="14,12" CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="#FF3E8DD1" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="HeadingText" Text="New task" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Enter to add   ·   Esc to close" FontSize="11" Margin="0,0,0,6"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>

            <TextBox Grid.Row="1" Grid.Column="0" x:Name="TaskTextBox" FontSize="16" Padding="8,6" TextChanged="TaskTextBox_TextChanged"
                     SpellCheck.IsEnabled="True" Language="en-CA"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProjectComboBox" DisplayMemberPath="Name" MinWidth="150" MaxWidth="220"
                      Margin="8,0,0,0" Padding="6" VerticalContentAlignment="Center" ToolTip="Project for the new task"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PreviewText" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Grid>
    </Border>
</Window>
