<Window x:Class="KanbanApp.Views.ManageCustomFiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Custom Filters" Width="680" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Custom Filters" FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextStrongBrush}"
                       Text="Set the board's filters how you want them, then save them to a slot below. Pressing that slot's Alt key from the board applies them again instantly."/>
        </StackPanel>

        <ListBox x:Name="SlotList" Grid.Row="1" BorderThickness="1"
                 BorderBrush="{DynamicResource CardBorderBrush}"
                 Background="{DynamicResource InputBackgroundBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="SlotList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="6,5"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ButtonBackgroundBrush}"
                                CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Shortcut}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextStrongBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="SaveCurrentButton" Content="Save current filters here..." Padding="10,6" Margin="0,0,8,0"
                    Click="SaveCurrent_Click"
                    ToolTip="Store the board's current filters in the selected slot"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="RenameButton" Content="Rename..." Padding="10,6" Margin="0,0,8,0"
                    Click="Rename_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="ApplyButton" Content="Apply" Padding="10,6" Margin="0,0,8,0"
                    Click="Apply_Click"
                    ToolTip="Apply this slot to the board now"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Button x:Name="ClearButton" Content="Clear" Padding="10,6"
                    Click="Clear_Click"
                    ToolTip="Empty this slot"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Close" Width="90" Padding="0,6" Margin="0,12,0,0"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
    </Grid>
</Window>
