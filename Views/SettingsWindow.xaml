<Window x:Class="KanbanApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings" Height="500" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Layout" Style="{StaticResource SectionHeaderStyle}"/>
        <CheckBox Grid.Row="1" x:Name="ButtonsOnRightCheckBox" Content="Show the button panel on the right side of the board"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"
                  Checked="ButtonsOnRightCheckBox_Changed" Unchecked="ButtonsOnRightCheckBox_Changed"/>

        <TextBlock Grid.Row="2" Text="Startup" Style="{StaticResource SectionHeaderStyle}"/>
        <CheckBox Grid.Row="3" x:Name="ShowSplashCheckBox" Content="Show splash screen on startup"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"
                  Checked="ShowSplashCheckBox_Changed" Unchecked="ShowSplashCheckBox_Changed"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Splash duration:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <ComboBox x:Name="SplashDelayComboBox" Width="140" Padding="4"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      SelectionChanged="SplashDelayComboBox_SelectionChanged">
                <ComboBoxItem Content="1 second" Tag="1000"/>
                <ComboBoxItem Content="2 seconds" Tag="2000"/>
                <ComboBoxItem Content="3 seconds" Tag="3000"/>
                <ComboBoxItem Content="4 seconds" Tag="4000"/>
            </ComboBox>
        </StackPanel>
        <CheckBox Grid.Row="5" x:Name="StartFullScreenCheckBox" Content="Start in full screen"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"
                  Checked="StartFullScreenCheckBox_Changed" Unchecked="StartFullScreenCheckBox_Changed"/>

        <TextBlock Grid.Row="6" Text="Behavior" Style="{StaticResource SectionHeaderStyle}"/>
        <CheckBox Grid.Row="7" x:Name="ConfirmDeleteCheckBox" Content="Confirm before deleting a task, project, goal, or flag"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"
                  Checked="ConfirmDeleteCheckBox_Changed" Unchecked="ConfirmDeleteCheckBox_Changed"/>
        <CheckBox Grid.Row="8" x:Name="AddNoteOnCompleteCheckBox" Content="Ask to add a note when a task is marked Done"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"
                  Checked="AddNoteOnCompleteCheckBox_Changed" Unchecked="AddNoteOnCompleteCheckBox_Changed"/>

        <TextBlock Grid.Row="9" Text="Data Storage" Style="{StaticResource SectionHeaderStyle}"/>
        <TextBlock Grid.Row="10" Text="The task database is currently stored at:" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="11" x:Name="DbPathTextBox" IsReadOnly="True" Padding="6" Margin="0,0,0,10"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource CardBorderBrush}"/>

        <StackPanel Grid.Row="12" VerticalAlignment="Top" Margin="0,0,0,20">
            <Button Content="Change Location..." Padding="10,6" HorizontalAlignment="Left" Click="ChangeLocation_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Changing the location moves the database file, restarts the app, and removes the old file once the new one is confirmed working." FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="This path itself is remembered outside the database, in a small config file under your local AppData folder — not inside the database file shown above." FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="13" Text="Import / Export" Style="{StaticResource SectionHeaderStyle}"/>
        <TextBlock Grid.Row="14" Text="Default Export Path" Style="{StaticResource FieldLabelStyle}"/>
        <Grid Grid.Row="15" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ExportPathTextBox" Padding="6" LostFocus="ExportPathTextBox_LostFocus"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BrowseButtonStyle}" Click="BrowseExportPath_Click"/>
        </Grid>

        <TextBlock Grid.Row="16" Text="Default Import Path" Style="{StaticResource FieldLabelStyle}"/>
        <Grid Grid.Row="17" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ImportPathTextBox" Padding="6" LostFocus="ImportPathTextBox_LostFocus"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BrowseButtonStyle}" Click="BrowseImportPath_Click"/>
        </Grid>

        <TextBlock Grid.Row="18" Text="Linked Files" Style="{StaticResource SectionHeaderStyle}"/>
        <TextBlock Grid.Row="19" Text="Linked Files Default Path" Style="{StaticResource FieldLabelStyle}"/>
        <Grid Grid.Row="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LinkedFilesPathTextBox" Padding="6" LostFocus="LinkedFilesPathTextBox_LostFocus"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}"/>
            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BrowseButtonStyle}" Click="BrowseLinkedFilesPath_Click"/>
        </Grid>

        <TextBlock Grid.Row="21" Text="This folder will be used once file linking support is added."
                   FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>

        <Button Grid.Row="22" Content="Save &amp; Close" Width="120" Padding="0,6" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
    </Grid>
</Window>
