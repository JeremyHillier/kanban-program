<Window x:Class="KanbanApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Layout" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <CheckBox Grid.Row="1" x:Name="ButtonsOnRightCheckBox" Content="Show the button panel on the right side of the board"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"
                  Checked="ButtonsOnRightCheckBox_Changed" Unchecked="ButtonsOnRightCheckBox_Changed"/>

        <TextBlock Grid.Row="2" Text="Startup" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <CheckBox Grid.Row="3" x:Name="ShowSplashCheckBox" Content="Show splash screen on startup"
                  Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"
                  Checked="ShowSplashCheckBox_Changed" Unchecked="ShowSplashCheckBox_Changed"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Splash duration:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <ComboBox x:Name="SplashDelayComboBox" Width="140" Padding="4"
                      Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}"
                      SelectionChanged="SplashDelayComboBox_SelectionChanged">
                <ComboBoxItem Content="1 second" Tag="1000"/>
                <ComboBoxItem Content="2 seconds" Tag="2000"/>
                <ComboBoxItem Content="3 seconds" Tag="3000"/>
                <ComboBoxItem Content="4 seconds" Tag="4000"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="Data Storage" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock Grid.Row="6" Text="The task database is currently stored at:" Margin="0,0,0,4"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="7" x:Name="DbPathTextBox" IsReadOnly="True" Padding="6" Margin="0,0,0,10"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                 BorderBrush="{DynamicResource CardBorderBrush}"/>

        <StackPanel Grid.Row="8" VerticalAlignment="Top">
            <Button Content="Change Location..." Padding="10,6" HorizontalAlignment="Left" Click="ChangeLocation_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Changing the location moves the database file and restarts the app." FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Grid.Row="9" Content="Close" Width="90" Padding="0,6" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsCancel="True"
                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
    </Grid>
</Window>
